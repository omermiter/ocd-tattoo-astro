---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import { getDict, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);
const s = t.request.steps;
const totalSteps = 6;
---

<BaseLayout locale={locale} title={`${t.request.title} — OCD Tattoo`} description={t.request.title}>
  <Nav locale={locale} active="request" />

  <main class="wizard-main">
    <form class="wizard" data-wizard novalidate>
      <input type="hidden" data-locale value={locale} />
      <p class="mono step-count ltr-num" data-step-count>{t.request.stepOf(1, totalSteps)}</p>

      <div class="step" data-step="0">
        <label for="f-placement">{s.placement.label}</label>
        <input id="f-placement" type="text" name="placement" placeholder={s.placement.placeholder} autocomplete="off" />
        <div class="nav">
          <button type="button" class="mono next" data-next>{t.request.continueCta} →</button>
        </div>
      </div>

      <div class="step" data-step="1" hidden>
        <label for="f-size">{s.size.label}</label>
        <input id="f-size" type="text" name="size" placeholder={s.size.placeholder} autocomplete="off" />
        <div class="nav">
          <button type="button" class="mono back" data-back>← {t.request.backCta}</button>
          <button type="button" class="mono next" data-next>{t.request.continueCta} →</button>
        </div>
      </div>

      <div class="step" data-step="2" hidden>
        <label for="f-reference">{s.reference.label}</label>
        <input id="f-reference" type="file" name="reference" accept="image/*" multiple />
        <p class="hint">{s.reference.hint}</p>
        <div class="nav">
          <button type="button" class="mono back" data-back>← {t.request.backCta}</button>
          <button type="button" class="mono next" data-next>{t.request.continueCta} →</button>
        </div>
      </div>

      <div class="step" data-step="3" hidden>
        <label for="f-window">{s.window.label}</label>
        <input id="f-window" type="text" name="window" placeholder={s.window.placeholder} autocomplete="off" />
        <div class="nav">
          <button type="button" class="mono back" data-back>← {t.request.backCta}</button>
          <button type="button" class="mono next" data-next>{t.request.continueCta} →</button>
        </div>
      </div>

      <div class="step" data-step="4" hidden>
        <label for="f-description">{s.description.label}</label>
        <textarea id="f-description" name="description" rows="5" placeholder={s.description.placeholder}
        ></textarea>
        <div class="nav">
          <button type="button" class="mono back" data-back>← {t.request.backCta}</button>
          <button type="button" class="mono submit" data-submit>{t.request.submitCta} →</button>
        </div>
      </div>

      <div class="step closing" data-step="5" hidden>
        <h2>{t.request.closingTitle}</h2>
        <p>{t.request.closingBody}</p>
      </div>
    </form>
  </main>

  <Footer locale={locale} />

  <script>
    import { requestLink } from '../../lib/whatsapp';

    const form = document.querySelector<HTMLFormElement>('[data-wizard]');
    if (form) {
      const steps = Array.from(form.querySelectorAll<HTMLElement>('[data-step]'));
      const stepCount = form.querySelector<HTMLElement>('[data-step-count]');
      const total = steps.length - 1;
      let index = 0;

      const stepOf = (n: number, t: number) =>
        `${String(n).padStart(2, '0')} / ${String(t).padStart(2, '0')}`;

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const show = (i: number) => {
        steps.forEach((el, idx) => {
          el.hidden = idx !== i;
          if (idx === i && !reduced) {
            el.classList.add('entering');
            requestAnimationFrame(() => {
              requestAnimationFrame(() => el.classList.remove('entering'));
            });
          }
        });
        if (stepCount) {
          stepCount.style.display = i === total ? 'none' : '';
          stepCount.textContent = stepOf(i + 1, total + 1);
        }
      };

      form.querySelectorAll<HTMLButtonElement>('[data-next]').forEach((btn) => {
        btn.addEventListener('click', () => {
          index = Math.min(index + 1, total);
          show(index);
        });
      });
      form.querySelectorAll<HTMLButtonElement>('[data-back]').forEach((btn) => {
        btn.addEventListener('click', () => {
          index = Math.max(index - 1, 0);
          show(index);
        });
      });

      const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit]');
      const localeInput = form.querySelector<HTMLInputElement>('[data-locale]');
      submitBtn?.addEventListener('click', () => {
        const data = new FormData(form);
        const answers = {
          placement: String(data.get('placement') ?? ''),
          size: String(data.get('size') ?? ''),
          window: String(data.get('window') ?? ''),
          description: String(data.get('description') ?? ''),
        };
        const locale = localeInput?.value === 'en' ? 'en' : 'he';
        const url = requestLink(locale, answers);
        window.open(url, '_blank', 'noopener');
        index = total;
        show(index);
      });

      show(index);
    }
  </script>

  <style>
    .wizard-main {
      max-width: 34rem;
      margin-inline: auto;
      padding: var(--sp-6) var(--sp-3);
      min-block-size: 60vh;
      display: flex;
      align-items: center;
    }

    .wizard {
      width: 100%;
    }

    .step-count {
      color: var(--ash);
      font-size: var(--fs-000);
      margin-block-end: var(--sp-4);
    }

    .step {
      opacity: 1;
      transform: translateY(0);
      transition:
        opacity var(--dur-base) var(--ease-house),
        transform var(--dur-base) var(--ease-house);
    }

    .step.entering {
      opacity: 0;
      transform: translateY(8px);
    }

    .step label {
      display: block;
      font-size: var(--fs-1);
      color: var(--bone);
      margin-block-end: var(--sp-3);
    }

    .step input[type='text'],
    .step textarea {
      width: 100%;
      border-block-end: var(--border-hairline);
      padding-block: var(--sp-1);
      font-size: var(--fs-1);
      color: var(--pewter);
      background: transparent;
    }

    .step input[type='text']:focus,
    .step textarea:focus {
      border-color: var(--transfer);
    }

    .step input[type='file'] {
      color: var(--ash);
      font-size: var(--fs-00);
    }

    .hint {
      color: var(--ash);
      font-size: var(--fs-000);
      margin-block-start: var(--sp-1);
    }

    .nav {
      display: flex;
      justify-content: space-between;
      margin-block-start: var(--sp-4);
    }

    .nav button {
      cursor: pointer;
      font-size: var(--fs-00);
    }

    .next,
    .submit {
      color: var(--bone);
      margin-inline-start: auto;
    }

    .back {
      color: var(--ash);
    }

    .closing h2 {
      font-size: var(--fs-display-sm);
      margin-block-end: var(--sp-3);
    }

    .closing p {
      color: var(--pewter);
    }
  </style>
</BaseLayout>
