---
import { hasPhoto, pieceFallback, pieceSrcset } from '../lib/media';
import { pixelArtExists, pixelArtPath } from '../lib/pixelArt';
import { t, type Locale } from '../i18n/ui';

interface Props {
  photo?: string;
  serial: string;
  alt: string;
  ratio?: string;
  locale?: Locale;
}

const { photo, serial, alt, ratio = '4 / 5', locale = 'en' } = Astro.props;
const ui = t(locale);
const available = photo ? hasPhoto(photo) : false;
const hasPendingMark = pixelArtExists('pending-mark.png');
---

<div
  class="piece-media"
  class:list={[{ pending: !available }]}
  style={available ? `aspect-ratio: ${ratio}` : undefined}
  data-frame-reveal={available ? '' : undefined}
>
  {
    available && photo ? (
      <button
        type="button"
        class="piece-media-trigger"
        data-lightbox-trigger
        data-lightbox-src={pieceFallback(photo)}
        data-lightbox-alt={alt}
        aria-label={`${ui.pieceCard.expand} — ${alt}`}
      >
        {/* sizes' mobile branch subtracts .section's own horizontal padding
           (--sp-3, 1.75rem each side — see HomePage.astro) from 100vw: the
           image never actually renders edge-to-edge on mobile, and claiming
           it does was making the browser fetch the 1100w candidate where
           600w already covers the real rendered width. */}
        <img
          src={pieceFallback(photo)}
          srcset={pieceSrcset(photo)}
          sizes="(min-width: 800px) 26rem, calc(100vw - 3.5rem)"
          alt={alt}
          loading="lazy"
        />
      </button>
    ) : (
      <div class="pending-panel grid-texture" role="img" aria-label={`${alt} — ${ui.pieceCard.photographyPending}`}>
        {hasPendingMark && <img class="pending-mark pixel-art" src={pixelArtPath('pending-mark.png')} alt="" width="32" height="32" loading="lazy" />}
        <span class="serial">{serial}</span>
        <span class="data pending-label">{ui.pieceCard.photographyPending}</span>
      </div>
    )
  }
</div>

<style>
  .piece-media {
    position: relative;
    overflow: hidden;
    background: var(--surface);
    border: var(--border-hairline);
  }

  .piece-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .piece-media-trigger {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
  }

  /* A missing photo is treated as a deliberate specimen card, not an empty
     box waiting to be filled — capped height, real typographic weight, so
     it reads as "not photographed yet" rather than "unfinished template". */
  .piece-media.pending {
    aspect-ratio: unset;
  }

  .pending-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    padding: var(--sp-5) var(--sp-2);
  }

  .pending-mark {
    width: 32px;
    height: 32px;
  }

  .serial {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-display-sm);
    color: var(--dust);
  }

  .pending-label {
    text-transform: uppercase;
  }
</style>
