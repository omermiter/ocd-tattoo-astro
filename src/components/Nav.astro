---
import { isAssetMissing, getAsset } from '../lib/placeholders';
import PixelPlaceholder from './PixelPlaceholder.astro';
import { pixelArtExists, pixelArtPath } from '../lib/pixelArt';
import { t, localePath, type Locale } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const ui = t(locale);
const otherLocale: Locale = locale === 'en' ? 'he' : 'en';
const home = localePath(locale);

// Modeled on kameralnie.com/polanki: a framed box with the brand sitting on
// its top edge, section links pipe-divided in the middle, Contact + the
// language switch set apart at the end. Hrefs carry the locale root so the
// links also work from the 404 page, not just the homepage.
const mainLinks = [
  { key: 'pieces', label: ui.nav.pieces, href: `${home}#pieces` },
  { key: 'reviews', label: ui.nav.reviews, href: `${home}#reviews` },
] as const;

const markMissing = isAssetMissing('mark');
const markAsset = getAsset('mark');
const hasMark = pixelArtExists('mark.png');
---

<nav class="nav" data-nav>
  <div class="frame">
    <div class="frame-top">
      <span class="frame-edge" aria-hidden="true"></span>
      <a class="brand" href={home}>
        {
          hasMark ? (
            <img class="brand-mark pixel-art" src={pixelArtPath('mark.png')} alt="" width={markAsset.width} height={markAsset.height} />
          ) : (
            markMissing && <PixelPlaceholder id="mark" width={markAsset.width} height={markAsset.height} label="mark" />
          )
        }
        <span class="data">OCD·TATTOO</span>
      </a>
      <span class="frame-edge frame-edge--fill" aria-hidden="true"></span>
    </div>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-panel" aria-label={ui.nav.menu}>
      <span></span>
    </button>

    <div class="panel" id="nav-panel">
      <ul class="links links-main data">
        {
          mainLinks.map((l) => (
            <li>
              <a class="underline" href={l.href} data-section={l.key}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="links links-end data">
        <li>
          <a class="underline contact" href={`${home}#contact`} data-section="contact">
            {ui.nav.contact}
          </a>
        </li>
        <li>
          <a class="underline lang-switch" href={localePath(otherLocale)} hreflang={otherLocale} lang={otherLocale} dir={otherLocale === 'he' ? 'rtl' : 'ltr'}>
            {ui.nav.switchTo}
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const panel = document.querySelector<HTMLElement>('#nav-panel');

  if (nav && toggle && panel) {
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';
    const close = () => {
      toggle.setAttribute('aria-expanded', 'false');
      panel.removeAttribute('data-open');
    };
    toggle.addEventListener('click', () => {
      const open = isOpen();
      toggle.setAttribute('aria-expanded', String(!open));
      if (open) panel.removeAttribute('data-open');
      else panel.setAttribute('data-open', 'true');
    });
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });

    // Transparent over the hero, solid once scrolled; slides away while
    // scrolling down and returns on any scroll up. Keyboard focus inside the
    // nav always brings it back so it's never tabbed into while hidden.
    let lastY = window.scrollY;
    let ticking = false;
    const update = () => {
      const y = window.scrollY;
      nav.classList.toggle('is-solid', y > 8);
      const goingDown = y > lastY;
      const hide = goingDown && y > nav.offsetHeight && !isOpen() && !nav.contains(document.activeElement);
      nav.classList.toggle('is-hidden', hide);
      lastY = y;
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    nav.addEventListener('focusin', () => nav.classList.remove('is-hidden'));
    update();

    // Current-section highlight — the one-page equivalent of the
    // reference's bold current-page item.
    const links = new Map<string, HTMLElement>();
    nav.querySelectorAll<HTMLElement>('[data-section]').forEach((a) => links.set(a.dataset.section!, a));
    const sections = [...links.keys()].map((id) => document.getElementById(id)).filter((s): s is HTMLElement => !!s);
    if (sections.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const link = links.get(entry.target.id);
            if (!link) return;
            if (entry.isIntersecting) {
              links.forEach((l) => l.removeAttribute('aria-current'));
              link.setAttribute('aria-current', 'location');
            } else if (link.getAttribute('aria-current')) {
              link.removeAttribute('aria-current');
            }
          });
        },
        { rootMargin: '-45% 0px -50% 0px' },
      );
      sections.forEach((s) => observer.observe(s));
    }
  }
</script>

<style>
  .nav {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 30;
    padding: var(--sp-3) var(--sp-4) var(--sp-2);
    background: transparent;
    transition:
      transform var(--dur-base) var(--ease-precise),
      background-color var(--dur-base) var(--ease-precise);
  }

  .nav.is-solid {
    background: var(--ink);
  }

  .nav.is-hidden {
    transform: translateY(-100%);
  }

  /* The box: three sides are a plain border; the top edge is drawn as
     line segments either side of the brand, so the brand breaks the line
     without needing a background knockout (the nav is transparent over
     the hero photo). */
  .frame {
    position: relative;
    display: flex;
    align-items: center;
    min-block-size: 3.5rem;
    padding-inline: var(--sp-3);
    border: 1px solid var(--line-light);
    border-block-start: none;
  }

  .frame-top {
    position: absolute;
    inset-block-start: 0;
    inset-inline: -1px;
    display: flex;
    align-items: center;
    transform: translateY(-50%);
  }

  .frame-edge {
    block-size: 1px;
    inline-size: var(--sp-4);
    background: var(--line-light);
  }

  .frame-edge--fill {
    flex: 1;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    padding-inline: var(--sp-2);
    text-decoration: none;
    letter-spacing: 0.1em;
    color: var(--paper);
  }

  /* 20x40 = 1x mark.png's actual source canvas — integer scale, per
     ASSETS-TO-DRAW.md. Never display this smaller/larger at a fraction. */
  .brand-mark {
    width: 20px;
    height: 40px;
  }

  .brand :global([data-placeholder]) {
    width: 20px;
    height: 40px;
  }

  .menu-toggle {
    display: none;
    width: 20px;
    height: 14px;
    position: relative;
    cursor: pointer;
    margin-inline-start: auto;
  }

  .menu-toggle span,
  .menu-toggle span::before,
  .menu-toggle span::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    width: 100%;
    height: 1px;
    background: var(--paper);
  }

  .menu-toggle span {
    top: 6px;
  }

  .menu-toggle span::before {
    top: -6px;
  }

  .menu-toggle span::after {
    top: 6px;
  }

  .panel {
    display: contents;
  }

  .links {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    text-transform: uppercase;
  }

  /* Section links centered in the box, the end cluster pinned to the far
     edge — the reference's layout. */
  .links-main {
    margin-inline: auto;
  }

  .links li {
    padding-inline: var(--sp-3);
    border-inline-start: var(--border-hairline);
  }

  .links li:first-child {
    padding-inline-start: 0;
    border-inline-start: none;
  }

  .links a {
    text-decoration: none;
    color: var(--dust);
    transition: color var(--dur-base) var(--ease-precise);
  }

  .links a:hover {
    color: var(--paper);
  }

  /* Current section: weight + full-strength color, the reference's bold
     current item. Contact keeps its --claim color either way. */
  .links a[aria-current] {
    color: var(--paper);
    font-weight: 500;
  }

  .links a.contact,
  .links a.contact[aria-current] {
    color: var(--claim);
  }

  .links a.contact:hover {
    color: var(--paper);
  }

  @media (max-width: 640px) {
    .nav {
      padding-inline: var(--sp-2);
    }

    .frame-edge {
      inline-size: var(--sp-2);
    }

    .menu-toggle {
      display: block;
    }

    .panel {
      display: block;
      position: absolute;
      inset-inline: -1px;
      top: 100%;
      background: var(--ink);
      border: 1px solid var(--line-light);
      border-block-start: none;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-0.5rem);
      transform-origin: top;
      transition:
        opacity var(--dur-base) var(--ease-precise),
        transform var(--dur-base) var(--ease-precise),
        visibility var(--dur-base) var(--ease-precise);
      z-index: 20;
    }

    .panel[data-open] {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .links {
      flex-direction: column;
    }

    .links-main {
      margin-inline: 0;
    }

    .links li {
      padding-inline: 0;
      border-inline-start: none;
    }

    .links a {
      display: block;
      padding: var(--sp-2) var(--sp-3);
      border-block-end: var(--border-hairline);
    }
  }
</style>
