---
import { hasPhoto } from '../lib/media';
import { pixelArtPath, spriteFrameCount } from '../lib/pixelArt';

interface Props {
  photo?: string;
  serial: string;
  alt: string;
  ratio?: string;
}

const { photo, serial, alt, ratio = '4 / 5' } = Astro.props;
const available = photo ? hasPhoto(photo) : false;

// The lift-and-burst hover plays over every card, photographed or not — a
// piece that isn't shot yet is still a real entry in the register, not a
// lesser one, so it gets the same considered interaction. Only loads the
// sprite's bytes once the thumbnail scrolls into view (see the observer
// below), and only plays on hover/focus. Skipped entirely if missing.
const hoverBurstFrames = await spriteFrameCount('hover-burst.png');
const hoverBurstSrc = hoverBurstFrames ? pixelArtPath('hover-burst.png') : null;
---

<div class="piece-media" class:list={[{ pending: !available }]} style={available ? `aspect-ratio: ${ratio}` : undefined}>
  {
    available && photo ? (
      <img class="lift-target" src={photo} alt={alt} loading="lazy" />
    ) : (
      <div class="pending-panel lift-target grid-texture" role="img" aria-label={`${alt} — not yet photographed`}>
        <span class="serial">{serial}</span>
        <span class="data pending-label">Photography pending</span>
      </div>
    )
  }
  {
    hoverBurstFrames && hoverBurstSrc && (
      <span
        class="hover-burst pixel-art"
        data-hover-burst
        data-src={hoverBurstSrc}
        data-frames={hoverBurstFrames}
        style={`--frames:${hoverBurstFrames}`}
        aria-hidden="true"
      />
    )
  }
</div>

<script>
  const bursts = document.querySelectorAll<HTMLElement>('[data-hover-burst]');
  if (bursts.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const src = el.dataset.src;
          const container = el.closest<HTMLElement>('.piece-media');
          const frames = Number(el.dataset.frames ?? '1');
          if (!src || !container) return;

          const img = new Image();
          img.onerror = () => el.remove();
          img.onload = () => {
            el.style.backgroundImage = `url(${src})`;

            // One-shot flip-book: plays through the strip exactly once per
            // hover-in, holding on the final (near-invisible) frame rather
            // than looping — the pulse is a single reaction, not ambient
            // motion. Re-hovering after it finishes plays it again.
            let frame = 0;
            let playing = false;
            let done = false;
            let rafId = 0;
            let lastStep = 0;
            const STEP_MS = 35;

            const render = () => {
              const pct = frames > 1 ? (frame / (frames - 1)) * 100 : 0;
              el.style.backgroundPosition = `${pct}% 0`;
            };

            const step = (ts: number) => {
              if (!lastStep) lastStep = ts;
              if (ts - lastStep >= STEP_MS) {
                frame++;
                lastStep = ts;
                render();
                if (frame >= frames - 1) {
                  playing = false;
                  done = true;
                  return;
                }
              }
              rafId = requestAnimationFrame(step);
            };

            const play = () => {
              if (playing || done) return;
              playing = true;
              frame = 0;
              lastStep = 0;
              render();
              rafId = requestAnimationFrame(step);
            };

            container.addEventListener('mouseenter', play);
            container.addEventListener('focusin', play);
            container.addEventListener('mouseleave', () => {
              // Reset so the next hover plays from the start again, but only
              // once the current run has actually finished — leaving
              // mid-pulse lets it finish rather than cutting it off.
              if (!playing) {
                done = false;
                cancelAnimationFrame(rafId);
              }
            });
          };
          img.src = src;
          observer.unobserve(el);
        });
      },
      { rootMargin: '300px' },
    );
    bursts.forEach((el) => observer.observe(el));
  }
</script>

<style>
  .piece-media {
    position: relative;
    overflow: hidden;
    background: var(--surface);
    border: var(--border-hairline);
  }

  .piece-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The photo — or the placeholder panel, when there isn't one yet — lifts
     up within its own frame on hover, uncovering a strip of the frame's own
     background at the bottom where the burst plays. Both effects stay
     inside the existing bordered box, nothing resizes. */
  .lift-target {
    transition: transform var(--dur-slow) var(--ease-precise);
  }

  .piece-media:hover .lift-target,
  .piece-media:focus-within .lift-target {
    transform: translateY(-108px);
  }

  /* Fixed square size, anchored to the bottom of the frame (the space the
     lifted photo just uncovered) — must stay square itself, or the strip's
     frames stretch instead of scaling up cleanly. Frame stepping is driven
     by JS (one-shot per hover, not a looping CSS animation — see script). */
  .hover-burst {
    position: absolute;
    inset-block-end: var(--sp-1);
    inset-inline-start: 50%;
    width: 96px;
    aspect-ratio: 1;
    transform: translateX(-50%);
    background-repeat: no-repeat;
    background-size: calc(var(--frames, 1) * 100%) 100%;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-precise);
    pointer-events: none;
  }

  .piece-media:hover .hover-burst,
  .piece-media:focus-within .hover-burst {
    opacity: 1;
  }

  /* A missing photo is treated as a deliberate specimen card, not an empty
     box waiting to be filled — capped height, real typographic weight, so
     it reads as "not photographed yet" rather than "unfinished template". */
  .piece-media.pending {
    aspect-ratio: unset;
  }

  .pending-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    padding: var(--sp-5) var(--sp-2);
  }

  .serial {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-display-sm);
    color: var(--dust);
  }

  .pending-label {
    text-transform: uppercase;
  }
</style>
