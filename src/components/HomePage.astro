---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import PrecisionGrid from './PrecisionGrid.astro';
import PieceCard from './PieceCard.astro';
import GoogleReviews from './GoogleReviews.astro';
import Preloader from './Preloader.astro';
import PixelDivider from './PixelDivider.astro';
import { renderEmphasis } from '../lib/text';
import { hasPhoto } from '../lib/media';
import { whatsappLink, CONTACT_ENDPOINT } from '../lib/contact';
import { fetchGoogleReviews } from '../lib/googleReviews';
import { t, localePath, type Locale } from '../i18n/ui';
import site from '../data/site.json';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const ui = t(locale);

const pieces = (await getCollection('pieces')).sort((a, b) => (a.data.serial < b.data.serial ? -1 : 1));
// A plain list field in site.json (not a content collection, unlike pieces)
// so the admin panel's list widget gives real drag-to-reorder — see
// src/content.config.ts for why this moved off a folder collection.
const moreWork = site.gallery.filter((g) => hasPhoto(g.photo));
const { home, contact, googleReviews, bannerImage } = { home: site.locales[locale].home, contact: site.contact, googleReviews: site.googleReviews, bannerImage: site.bannerImage };
// hasPhoto is a plain build-time "does this file exist under public/" check
// despite the name (see src/lib/media.ts) — reused here so a bannerVideo
// path that's unset, or set but not actually uploaded yet, falls back to
// the banner image instead of a broken <video>.
const bannerVideo = site.bannerVideo && hasPhoto(site.bannerVideo) ? site.bannerVideo : undefined;
// "contain" (default): the smart no-crop fill, blurred backdrop behind the
// full, uncropped clip. "cover": crops edge to edge — bannerVideoPosition
// (an object-position keyword pair, e.g. "top", "bottom left") picks which
// part of the video stays on-screen. Both are set from /admin/.
const bannerVideoFit = site.bannerVideoFit === 'cover' ? 'cover' : 'contain';
const bannerVideoPosition = site.bannerVideoPosition || 'center';
const featureStrip = site.featureStrip[locale];
const reviewsData = await fetchGoogleReviews(googleReviews.placeId);

// The full-bleed photo break between Pieces and More Work — its own
// CMS-editable image (Middle Banner Image in /admin/), distinct from the
// hero banner above. Falls back to the first real piece photo if the
// configured path is unset or hasn't actually been uploaded, so the break
// never just vanishes.
const middleBannerImage =
  site.middleBannerImage && hasPhoto(site.middleBannerImage)
    ? site.middleBannerImage
    : pieces.find((p) => p.data.photo && hasPhoto(p.data.photo))?.data.photo;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: contact.studioName,
  image: `https://ocdtattoo.com${bannerImage}`,
  url: `https://ocdtattoo.com${localePath(locale)}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.address,
    addressCountry: 'IL',
  },
  sameAs: [contact.instagramUrl],
  ...(reviewsData && {
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: reviewsData.rating,
      reviewCount: reviewsData.reviewCount,
    },
  }),
};

const titles = {
  en: 'OCD Tattoo — Precision Color Tattoos in Kfar Saba, Israel',
  he: 'קעקועי צבע מדויקים בכפר סבא — OCD Tattoo',
};
const descriptions = {
  en: 'Color tattoos built on years of black-and-gray realism training, at Topa Tattoo Studio in Kfar Saba. A growing collection of precision-built pieces, real Google reviews, and commissions reviewed personally.',
  he: 'קעקועי צבע שנבנו על שנות אימון בריאליזם שחור-אפור, בטופה טאטו סטודיו בכפר סבא. אוסף הולך וגדל של עבודות מדויקות, ביקורות אמיתיות מגוגל, ועבודות מוזמנות שנבחנות אישית.',
};
---

<BaseLayout title={titles[locale]} description={descriptions[locale]} structuredData={structuredData} locale={locale}>
  <Preloader />
  <Nav locale={locale} />

  <main>
    <PrecisionGrid>
      <section class="hero" style={`--heroBg: url(${bannerImage})`}>
        {
          bannerVideo && (
            <div class="hero-media" data-hero-video aria-hidden="true">
              {bannerVideoFit === 'cover' ? (
                /* Manual crop: a single layer, edge to edge, cropped to
                   bannerVideoPosition — Omer's own call on what stays
                   visible, set in /admin/. */
                <video
                  class="hero-video-cover"
                  src={bannerVideo}
                  poster={bannerImage}
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="auto"
                  style={`object-position: ${bannerVideoPosition}`}
                />
              ) : (
                /* Smart fill (default): the same clip, twice. The blurred
                   copy fills the whole banner (cover — cropping is fine
                   here, it's just ambient color); the sharp copy sits on
                   top at object-fit: contain, so vertical footage always
                   shows in full, at full quality, with no crop — the blur
                   behind it fills what would otherwise be empty letterbox
                   space either side. bannerVideoPosition nudges the
                   uncropped clip toward that side instead of centering it.
                   Works unmodified for landscape footage too: contain then
                   just fills the frame and the blur layer sits invisibly
                   behind it. */
                <>
                  <video class="hero-video-blur" src={bannerVideo} poster={bannerImage} autoplay muted loop playsinline preload="auto" />
                  <video
                    class="hero-video-sharp"
                    src={bannerVideo}
                    poster={bannerImage}
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="auto"
                    style={`object-position: ${bannerVideoPosition}`}
                  />
                </>
              )}
            </div>
          )
        }
        <div class="hero-scrim" aria-hidden="true" />
        <div class="hero-content">
          <p class="eyebrow">{home.heroEyebrow}</p>
          <h1 data-split="hero" set:html={renderEmphasis(home.heroTitle)} />
          <GoogleReviews data={reviewsData} mapsUrl={contact.mapsUrl} variant="compact" locale={locale} />
        </div>
      </section>

      {
        bannerVideo && (
          <script>
            // Runs immediately after the two <video> elements above, before
            // the page has done much else — stops autoplaying video from
            // ever really starting to stream for anyone who's asked for
            // less motion or less data. The banner image (already the
            // poster) stays as the visual either way.
            const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
            if (reduced || saveData) {
              document.querySelectorAll<HTMLVideoElement>('[data-hero-video] video').forEach((v) => {
                v.pause();
                v.removeAttribute('src');
                v.load();
              });
              document.querySelector('[data-hero-video]')?.remove();
            } else {
              // The declarative `autoplay` attribute is enough on most
              // browsers, but some mobile engines silently never engage it
              // (timing/engine quirks around element insertion), leaving a
              // paused first frame with no error anywhere. Calling .play()
              // ourselves is the standard belt-and-suspenders fix — still
              // muted, still no user gesture required, so it's allowed by
              // the same autoplay policy either way. Retried once on
              // canplay in case the first attempt fires before the browser
              // has buffered enough (preload="auto" makes that rare, but
              // not impossible on a slow mobile connection).
              document.querySelectorAll<HTMLVideoElement>('[data-hero-video] video').forEach((v) => {
                v.muted = true;
                const tryPlay = () => v.play().catch(() => {});
                tryPlay();
                v.addEventListener('canplay', tryPlay, { once: true });
              });
            }
          </script>
        )
      }
    </PrecisionGrid>

    <section class="beat" data-reveal>
      <p class="subhead beat-text" data-grow-line>
        {home.beatText}
      </p>
      <a class="cta data underline" href="#pieces">{ui.beat.cta}</a>
    </section>

    <section class="feature-strip">
      {
        featureStrip.map((f) => (
          <div class="feature" data-grow-line>
            <p class="feature-label" data-split="scrub">{f.label}</p>
            <p class="feature-detail">{f.detail}</p>
          </div>
        ))
      }
    </section>

    <PixelDivider />

    <section class="section pieces" id="pieces">
      <header class="section-head" data-reveal>
        <p class="eyebrow">{ui.nav.pieces}</p>
        <p class="intro">{home.piecesIntro}</p>
      </header>

      <div class="piece-list">
        {pieces.map((p) => <div data-reveal><PieceCard entry={p} locale={locale} /></div>)}
      </div>
    </section>

    {
      middleBannerImage && (
        <div class="photo-break" data-parallax>
          <img src={middleBannerImage} alt="" loading="lazy" />
        </div>
      )
    }

    {
      moreWork.length > 0 && (
        <section class="section more-work" id="gallery">
          <header class="section-head" data-reveal>
            <p class="eyebrow">{ui.nav.gallery}</p>
            <p class="intro">{home.galleryIntro}</p>
          </header>

          <p class="drag-hint data" data-drag-hint aria-hidden="true">
            <span class="drag-hint-arrow">←</span>
            <span class="drag-hint-label">{ui.gallery.dragHint}</span>
            <span class="drag-hint-arrow">→</span>
          </p>

          <div class="work-grid" data-drag-scroll tabindex="0" role="region" aria-label={ui.gallery.scrollRegionLabel}>
            {/* Rotating badge that trails the cursor while it's over the
                strip — fine-pointer only (see motion.ts), and stands in for
                the site's usual pixel-art cursor for as long as it's shown,
                rather than the two overlapping. A generic ring + label, not
                photographic content, so it reads instantly as UI. */}
            <div class="drag-badge" data-drag-badge aria-hidden="true">
              <svg class="drag-badge-ring" viewBox="0 0 100 100">
                <path id={`drag-badge-path-${locale}`} d="M 50,50 m -38,0 a 38,38 0 1,1 76,0 a 38,38 0 1,1 -76,0" fill="none" />
                <text class="drag-badge-text data">
                  <textPath href={`#drag-badge-path-${locale}`} startOffset="0%">
                    {ui.gallery.dragBadge} · {ui.gallery.dragBadge} · {ui.gallery.dragBadge} ·{' '}
                  </textPath>
                </text>
              </svg>
              <span class="drag-badge-icon" aria-hidden="true">
                ↔
              </span>
            </div>
            {moreWork.map((g) => (
              <figure class="work-item" data-reveal>
                <div class="work-frame" data-frame-reveal>
                  <img src={g.photo} alt={g.title} loading="lazy" draggable="false" />
                </div>
                <figcaption class="data">{g.title}</figcaption>
              </figure>
            ))}
          </div>

          <p class="work-note data">{ui.gallery.note}</p>
        </section>
      )
    }

    <PixelDivider />

    <GoogleReviews data={reviewsData} mapsUrl={contact.mapsUrl} locale={locale}>
      <p class="intro">{home.reviewsIntro}</p>
    </GoogleReviews>

    <PixelDivider />

    <section class="section contact" id="contact">
      <header class="section-head" data-reveal>
        <p class="eyebrow">{ui.contact.eyebrow}</p>
        <h2 class="caps-serif" data-split="scrub">{home.closingTitle}</h2>
        <p class="intro">
          {home.contactIntro}
        </p>
      </header>

      <form class="form" data-contact-form novalidate data-reveal>
        <div class="field">
          <label class="data" for="name">{ui.contact.nameLabel}</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>

        <div class="field">
          <label class="data" for="email">{ui.contact.emailLabel}</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>

        <div class="field">
          <label class="data" for="message">{ui.contact.messageLabel}</label>
          <textarea id="message" name="message" rows="6" placeholder={ui.contact.messagePlaceholder} required></textarea>
        </div>

        <div class="actions">
          <button class="submit data" type="submit" data-submit>{ui.contact.send}</button>
          <p class="status data" data-status role="status" aria-live="polite"></p>
        </div>
      </form>
    </section>
  </main>

  <Footer locale={locale} />

  <style>
    .hero {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-block-size: 88vh;
      padding: var(--sp-3);
      /* The nav is fixed and transparent over this photo — clear it. */
      padding-block-start: var(--nav-h);
      overflow: hidden;
      /* Banner image is CMS-editable — see bannerImage in
         src/data/site.json (shared across both locales). Always painted,
         video (if any) layers on top of it — so a slow/failed video load
         never shows a gap, and reduced-motion/save-data visitors (see the
         inline script below) just see this. */
      background-image: var(--heroBg);
      background-size: cover;
      background-position: center;
    }

    .hero-media {
      position: absolute;
      inset: 0;
      z-index: 0;
    }

    .hero-video-blur,
    .hero-video-sharp,
    .hero-video-cover {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    /* Ambient fill: crops freely (it's just color/motion, never the
       subject), blurred heavily and scaled up a touch so the soft blur
       edge never peeks past the section's own edge. */
    .hero-video-blur {
      object-fit: cover;
      filter: blur(60px) brightness(0.6) saturate(1.1);
      transform: scale(1.15);
    }

    /* The actual footage: contain, never cover — this is the one rule that
       makes vertical video work here. A portrait clip renders at full size
       and full quality in the middle of the banner instead of being
       cropped down to a thin horizontal sliver; a landscape clip just
       fills the frame as normal and the blur layer sits invisibly behind
       it. */
    .hero-video-sharp {
      object-fit: contain;
    }

    /* Manual-crop mode (Video Fit: "Crop to fill" in /admin/): edge to
       edge, no blur layer needed since there's no letterbox left to fill.
       object-position comes from the inline style set above. */
    .hero-video-cover {
      object-fit: cover;
    }

    /* Same gradient as before, now its own layer so it sits above the
       video too — stays readable whether the banner is a photo or a
       vertical clip stretching well past the text column's width. */
    .hero-scrim {
      position: absolute;
      inset: 0;
      z-index: 1;
      background-image: linear-gradient(180deg, rgba(8, 8, 10, 0.6), rgba(8, 8, 10, 0.82));
    }

    .hero-content {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      gap: var(--sp-3);
      max-width: 60rem;
    }

    .hero h1 {
      font-size: var(--fs-display-lg);
    }

    .beat {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--sp-3);
      max-width: var(--content-max);
      margin-inline: auto;
      padding: var(--sp-5) var(--sp-3);
      border-block-start: var(--border-hairline);
    }

    .subhead {
      max-width: 34rem;
      color: var(--dust);
      font-size: var(--fs-2);
      line-height: 1.5;
    }

    /* Primary CTA — --claim by default, not just on hover: this is the
       site's one action color and should read as actionable at rest, not
       be discovered on hover. The shared .underline class already
       provides hover/focus feedback. See REDESIGN-PLAN.md §2. */
    .cta {
      flex-shrink: 0;
      color: var(--claim);
      text-transform: uppercase;
    }

    /* ---- Feature strip — borrowed layout language: a thin-hairline,
       centered 3-column row right after the intro paragraph, the same
       rhythm break a reference real-estate site uses ("PRESTIŻOWY ADRES /
       KAMERALNA KAMIENICA / PRAWDZIWE APARTAMENTY"). Dark palette kept
       as-is; only the structural pattern is borrowed. ---- */
    .feature-strip {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      max-width: var(--content-max);
      margin-inline: auto;
      padding: 0 var(--sp-3) var(--sp-5);
      text-align: center;
    }

    /* Divider drawn as a pseudo-element rather than a border so
       src/scripts/motion.ts can grow it top-to-bottom with scroll via
       --line-scale (defaults to 1: fully drawn with no JS). */
    .feature {
      position: relative;
      padding: var(--sp-3);
    }

    .feature::before {
      content: '';
      position: absolute;
      inset-block: 0;
      inset-inline-start: 0;
      width: 1px;
      background: var(--line);
      transform: scaleY(var(--line-scale, 1));
      transform-origin: top;
    }

    .feature:first-child::before {
      display: none;
    }

    /* The accent line beside the intro paragraph, borrowed from the
       reference site's growing vertical line — --violet, the structural
       accent, not --claim (that stays reserved for CTAs). */
    .beat-text {
      position: relative;
      padding-inline-start: var(--sp-3);
    }

    .beat-text::before {
      content: '';
      position: absolute;
      inset-block: 0;
      inset-inline-start: 0;
      width: 2px;
      background: var(--violet);
      transform: scaleY(var(--line-scale, 1));
      transform-origin: top;
    }

    .feature-label {
      font-family: var(--font-display);
      font-style: italic;
      font-size: var(--fs-2);
      color: var(--violet-display);
      margin-block-end: var(--sp-1);
    }

    .feature-detail {
      color: var(--dust);
      font-size: var(--fs-0);
      line-height: 1.5;
      max-width: 18rem;
      margin-inline: auto;
    }

    /* ---- Editorial caps heading — borrowed treatment for one moment of
       emphasis (the closing headline), not applied site-wide: tracked-out
       uppercase serif, the reference's signature typographic gesture. ---- */
    .caps-serif {
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 300;
    }

    /* ---- Full-bleed photo break — a real piece photo, edge-to-edge,
       between Pieces and More Work. Purely a rhythm break: no caption,
       no link, same device the reference site uses between story blocks. ---- */
    .photo-break {
      width: 100%;
      max-height: 48vh;
      overflow: hidden;
      border-block: var(--border-hairline);
    }

    .photo-break img {
      width: 100%;
      height: 48vh;
      object-fit: cover;
      display: block;
    }

    .section {
      max-width: var(--content-max);
      margin-inline: auto;
      padding: var(--sp-6) var(--sp-3);
      border-block-start: var(--border-hairline);
      scroll-margin-block-start: var(--sp-4);
    }

    .section-head {
      display: flex;
      flex-direction: column;
      gap: var(--sp-1);
      margin-block-end: var(--sp-5);
    }

    .section-head .eyebrow {
      text-transform: uppercase;
    }

    .section-head h2 {
      font-size: var(--fs-display-sm);
      margin-block: var(--sp-1);
    }

    .intro {
      max-width: 32rem;
      color: var(--dust);
      font-size: var(--fs-2);
    }

    .piece-list {
      display: flex;
      flex-direction: column;
      gap: var(--sp-6);
    }

    /* Horizontal scroller: native swipe on touch, a custom mouse-drag (see
       src/scripts/motion.ts) for anyone on a plain mouse, a wheel listener
       that converts vertical scroll to horizontal while hovering it. Native
       overflow-x is the fallback for everything — nothing here needs JS to
       be functional, only to feel nicer.
       Center-focus carousel, inspired by cynx.io's gallery feel: one card
       sits centered and at full strength, neighbors sit dimmed either
       side. The padding (half the track minus half a card) is what lets
       the first/last cards actually reach center; it's logical, so this
       mirrors correctly under RTL with no extra branching. --work-item-w
       is shared by the padding calc and the card width so they can never
       drift out of sync. */
    .work-grid {
      --work-item-w: clamp(14rem, 46vw, 20rem);
      display: flex;
      gap: var(--sp-3);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      padding-inline: calc(50% - var(--work-item-w) / 2);
      padding-block-end: var(--sp-1);
      cursor: grab;
      scrollbar-width: none;
      user-select: none;
    }

    .work-grid::-webkit-scrollbar {
      display: none;
    }

    .work-grid.is-dragging {
      cursor: grabbing;
      scroll-snap-type: none;
    }

    .work-item {
      flex: 0 0 auto;
      width: var(--work-item-w);
      scroll-snap-align: center;
    }

    /* Border/background live on the frame, not the image, so the image can
       zoom inside it during the scroll reveal without scaling its border.
       The dim/undim is the "focus pulls to center" read — off-centre cards
       sit darker and slightly desaturated until motion.ts's centerSnap()
       marks them active. */
    .work-frame {
      overflow: hidden;
      background: var(--surface);
      border: var(--border-hairline);
      filter: brightness(0.45) saturate(0.7);
      transition: filter var(--dur-base) var(--ease-precise);
    }

    .work-item.is-active .work-frame {
      filter: none;
    }

    .work-item img {
      width: 100%;
      aspect-ratio: 3 / 4;
      object-fit: cover;
      display: block;
      -webkit-user-drag: none;
      user-select: none;
    }

    .work-item figcaption {
      margin-block-start: var(--sp-1);
      color: var(--dust);
      font-size: var(--fs-00);
    }

    /* A real badge, not a caption — sharp corners and a claim-colored
       hairline (--radius stays 0 everywhere on this site), so it reads as
       an on-brand piece of UI rather than a stray instruction line. */
    .drag-hint {
      display: inline-flex;
      align-items: center;
      gap: var(--sp-2);
      margin-inline-start: auto;
      margin-block-end: var(--sp-3);
      padding: var(--sp-1) var(--sp-3);
      border: 1px solid var(--claim);
      color: var(--claim);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      transition: opacity var(--dur-base) var(--ease-precise);
    }

    /* The header row already ends with margin-block-end: var(--sp-5) (see
       .section-head) — pull the hint up into that gap instead of stacking
       a second one on top, and set it on the flex row so it sits at the
       far end (auto margin above does the actual pushing). */
    .more-work {
      display: flex;
      flex-direction: column;
    }

    .more-work .section-head {
      margin-block-end: var(--sp-3);
    }

    .drag-hint.is-hidden {
      opacity: 0;
    }

    .drag-hint-arrow {
      display: inline-block;
    }

    @media (prefers-reduced-motion: no-preference) {
      .drag-hint-arrow:first-child {
        animation: drag-hint-nudge 1.6s ease-in-out infinite;
      }

      .drag-hint-arrow:last-child {
        animation: drag-hint-nudge 1.6s ease-in-out infinite reverse;
      }
    }

    @keyframes drag-hint-nudge {
      0%,
      100% {
        transform: translateX(0);
      }
      50% {
        transform: translateX(-4px);
      }
    }

    /* ---- Cursor-follow drag badge — fine-pointer only, see motion.ts.
       Fixed positioning + JS transform, same technique as the site's own
       pixel-art cursor in Cursor.astro, so the motion feel matches; hides
       that cursor for as long as this is shown (see the html[data-drag-
       hover] rule in pixel-art.css) rather than the two overlapping. ---- */
    .drag-badge {
      position: fixed;
      top: 0;
      /* Physical left, not inset-inline-start: the JS positions this with
         translate() from real pointer clientX/clientY (always physical,
         LTR-oriented coordinates), so the untransformed anchor must be
         physical too — inset-inline-start flips to the right edge in RTL
         and sends the badge off-screen. */
      left: 0;
      width: 92px;
      height: 92px;
      display: grid;
      place-items: center;
      pointer-events: none;
      z-index: 40;
      opacity: 0;
      transition: opacity var(--dur-base) var(--ease-precise);
      will-change: transform;
    }

    .drag-badge.is-visible {
      opacity: 1;
    }

    .drag-badge-ring {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      animation: drag-badge-spin 12s linear infinite;
      /* Decorative traversal order, not reading order — and Chromium fails
         to lay textPath glyphs out at all (empty bbox) when direction:rtl
         inherits onto an SVG <text>, so this needs an explicit override on
         the Hebrew page rather than just leaving it inherited. */
      direction: ltr;
    }

    @media (prefers-reduced-motion: reduce) {
      .drag-badge-ring {
        animation: none;
      }
    }

    @keyframes drag-badge-spin {
      to {
        transform: rotate(360deg);
      }
    }

    .drag-badge-text {
      font-family: var(--font-data);
      font-size: 10.5px;
      letter-spacing: 0.15em;
      fill: var(--claim);
    }

    .drag-badge-icon {
      position: relative;
      font-size: var(--fs-2);
      color: var(--paper);
      background: var(--ink);
      border: var(--border-hairline);
      width: 2.25rem;
      height: 2.25rem;
      display: grid;
      place-items: center;
    }

    .work-note {
      margin-block-start: var(--sp-4);
      color: var(--dust);
    }

    /* ---- Contact section — centered on the page, editorial pacing
       matching the borrowed layout language (see .feature-strip above). ---- */
    .contact .section-head {
      align-items: center;
      text-align: center;
      margin-inline: auto;
    }

    .contact .section-head .intro {
      margin-inline: auto;
    }

    .contact .form {
      display: flex;
      flex-direction: column;
      gap: var(--sp-4);
      max-width: 34rem;
      margin-inline: auto;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: var(--sp-1);
    }

    .field label {
      text-transform: uppercase;
      color: var(--dust);
    }

    .field input,
    .field textarea {
      border-block-end: var(--border-hairline);
      padding-block: var(--sp-1);
      font-size: var(--fs-2);
      color: var(--paper);
      background: transparent;
      resize: vertical;
    }

    .field input:focus,
    .field textarea:focus {
      border-color: var(--claim);
    }

    .actions {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--sp-3);
      margin-block-start: var(--sp-2);
    }

    /* This is the site's highest-intent action — --claim at rest, same
       color family as every other CTA, not discovered on hover. See
       REDESIGN-PLAN.md §2. */
    .submit {
      cursor: pointer;
      color: var(--claim);
      text-transform: uppercase;
      border-block-end: 1px solid var(--claim);
      padding-block-end: 2px;
      transition: border-color var(--dur-base) var(--ease-precise);
    }

    .submit:hover {
      border-color: var(--paper);
    }

    .submit:disabled {
      cursor: default;
      color: var(--dust);
      border-color: var(--line);
    }

    .status {
      color: var(--dust);
    }

    .status[data-state='ok'] {
      color: var(--claim);
    }

    /* NOTE: the error state's WhatsApp link is injected via innerHTML at
       runtime (see the script below), so it never receives Astro's
       scoped-style attribute and a rule here would silently never match —
       confirmed by testing it live. Its color is set as an inline style
       directly in the generated markup instead, and stays --whatsapp, not
       --claim — see REDESIGN-PLAN.md §2. */

    @media (max-width: 800px) {
      .section {
        padding-block: var(--sp-5);
      }

      .feature-strip {
        grid-template-columns: 1fr;
        gap: var(--sp-4);
      }

      .feature {
        padding-block-start: var(--sp-3);
      }

      /* Stacked on mobile, so the divider becomes a top rule that draws
         in from the reading-start edge instead. */
      .feature::before {
        inset-block: 0 auto;
        inset-inline: 0;
        width: auto;
        height: 1px;
        transform: scaleX(var(--line-scale, 1));
        transform-origin: left;
      }

      :global([dir='rtl']) .feature::before {
        transform-origin: right;
      }

      .feature:first-child {
        padding-block-start: 0;
      }

      .photo-break,
      .photo-break img {
        max-height: 32vh;
        height: 32vh;
      }
    }
  </style>

  <script>
    import '../scripts/motion';
  </script>

  <script is:inline define:vars={{ wa: whatsappLink(), ENDPOINT: CONTACT_ENDPOINT, uiContact: ui.contact }}>
  const form = document.querySelector('[data-contact-form]');
  const submitBtn = document.querySelector('[data-submit]');
  const status = document.querySelector('[data-status]');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!(form instanceof HTMLFormElement) || !submitBtn || !status) return;

    const data = new FormData(form);
    const payload = {
      name: String(data.get('name') ?? ''),
      email: String(data.get('email') ?? ''),
      message: String(data.get('message') ?? ''),
    };

    submitBtn.disabled = true;
    status.dataset.state = '';
    status.textContent = uiContact.sending;

    try {
      const res = await fetch(ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error(String(res.status));
      status.dataset.state = 'ok';
      status.textContent = uiContact.sent;
      form.reset();
    } catch {
      status.dataset.state = 'error';
      status.innerHTML = `${uiContact.errorPrefix} <a class="underline" style="color:var(--whatsapp)" href="${wa}" target="_blank" rel="noopener noreferrer">${uiContact.errorLink}</a> ${uiContact.errorSuffix}`;
      submitBtn.disabled = false;
    }
  });
</script>
</BaseLayout>
