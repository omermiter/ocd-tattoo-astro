---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import { getDict, type Locale } from '../../i18n';
import { pagePath } from '../../lib/paths';
import { pixelArtPath, spriteFrameCount } from '../../lib/pixelArt';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);

// Hover-burst sprite: only plays on hover/focus and only loads its bytes
// once a thumbnail actually scrolls into view (see IntersectionObserver
// below) — skipped entirely if the artist hasn't dropped the sheet in yet.
const hoverBurstFrames = await spriteFrameCount('hover-burst.png');
const hoverBurstSrc = hoverBurstFrames ? pixelArtPath('hover-burst.png') : null;

const work = (await getCollection('work')).sort((a, b) => (a.data.serial < b.data.serial ? 1 : -1));

const placements = new Map<string, number>();
for (const w of work) {
  const key = locale === 'he' ? w.data.placement_he : w.data.placement_en;
  placements.set(key, (placements.get(key) ?? 0) + 1);
}
---

<BaseLayout
  locale={locale}
  title={`${t.work.title} — OCD Tattoo`}
  description={t.work.title}
>
  <Nav locale={locale} active="work" />

  <main class="archive">
    <header class="archive-head">
      <h1>{t.work.title}</h1>
      <span class="mono count">{t.work.pieces(work.length)}</span>
    </header>

    <div class="layout">
      <aside class="filters mono" data-filters>
        <p class="filters-label">{t.work.filter}</p>
        <ul>
          <li>
            <button type="button" data-filter="" aria-pressed="true">{t.work.placement} — {t.work.pieces(work.length)}</button>
          </li>
          {
            [...placements.entries()].map(([name, count]) => (
              <li>
                <button type="button" data-filter={name} aria-pressed="false">
                  {name} ({count})
                </button>
              </li>
            ))
          }
        </ul>
      </aside>

      <ol class="manifest" data-manifest>
        {
          work.map((w) => {
            const placement = locale === 'he' ? w.data.placement_he : w.data.placement_en;
            const title = locale === 'he' ? w.data.title_he : w.data.title_en;
            const healedAt = locale === 'he' ? w.data.healedAt_he : w.data.healedAt_en;
            return (
              <li class="row" data-placement={placement}>
                <a href={pagePath(locale, `work/${w.id}`)}>
                  <div class="thumb">
                    <Picture
                      src={w.data.images.healed}
                      alt={title}
                      formats={['avif', 'webp']}
                      widths={[300, 600]}
                      sizes="(min-width: 900px) 30vw, 90vw"
                    />
                    {
                      hoverBurstFrames && hoverBurstSrc && (
                        <span
                          class="hover-burst pixel-sprite pixel-art"
                          data-hover-burst
                          data-src={hoverBurstSrc}
                          style={`--frames:${hoverBurstFrames}`}
                          aria-hidden="true"
                        />
                      )
                    }
                  </div>
                  <div class="meta">
                    <p class="serial mono">{w.data.serial}</p>
                    <h2>{title}</h2>
                    <p class="sub mono">
                      {placement} · {healedAt} {t.work.healedSuffix}
                    </p>
                  </div>
                </a>
              </li>
            );
          })
        }
      </ol>
    </div>
  </main>

  <Footer locale={locale} />

  <script>
    const filters = document.querySelector<HTMLElement>('[data-filters]');
    const rows = document.querySelectorAll<HTMLElement>('[data-manifest] .row');
    filters?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!btn) return;
      filters.querySelectorAll('[data-filter]').forEach((b) => b.setAttribute('aria-pressed', 'false'));
      btn.setAttribute('aria-pressed', 'true');
      const value = btn.dataset.filter ?? '';
      rows.forEach((row) => {
        const match = !value || row.dataset.placement === value;
        row.style.display = match ? '' : 'none';
      });
    });

    const bursts = document.querySelectorAll<HTMLElement>('[data-hover-burst]');
    if (bursts.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLElement;
            const src = el.dataset.src;
            if (src) {
              const img = new Image();
              img.onload = () => {
                el.style.backgroundImage = `url(${src})`;
              };
              img.onerror = () => el.remove();
              img.src = src;
            }
            observer.unobserve(el);
          });
        },
        { rootMargin: '300px' },
      );
      bursts.forEach((el) => observer.observe(el));
    }
  </script>

  <style>
    .archive {
      max-width: var(--content-max);
      margin-inline: auto;
      padding: var(--sp-4) var(--sp-3);
    }

    .archive-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      border-block-end: var(--border-hairline);
      padding-block-end: var(--sp-3);
      margin-block-end: var(--sp-4);
    }

    .archive-head h1 {
      font-size: var(--fs-display-sm);
    }

    .count {
      color: var(--ash);
      font-size: var(--fs-00);
    }

    .layout {
      display: grid;
      grid-template-columns: 14rem 1fr;
      gap: var(--sp-5);
    }

    .filters {
      align-self: start;
      position: sticky;
      top: var(--sp-3);
      color: var(--ash);
      font-size: var(--fs-00);
    }

    .filters-label {
      color: var(--bone);
      margin-block-end: var(--sp-2);
    }

    .filters ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: var(--sp-1);
    }

    .filters button {
      cursor: pointer;
      color: var(--ash);
      text-align: start;
    }

    .filters button[aria-pressed='true'] {
      color: var(--transfer);
    }

    .manifest {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
    }

    .row {
      border-block-end: var(--border-hairline);
    }

    .row a {
      display: grid;
      grid-template-columns: 12rem 1fr;
      gap: var(--sp-4);
      align-items: center;
      padding-block: var(--sp-3);
      text-decoration: none;
      color: var(--pewter);
      border-inline-start: 2px solid transparent;
      transition: border-color var(--dur-base) var(--ease-house);
    }

    .row a:hover {
      border-inline-start-color: var(--stencil);
    }

    .thumb {
      position: relative;
      aspect-ratio: 4 / 5;
      overflow: hidden;
    }

    .thumb :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .hover-burst {
      position: absolute;
      inset: 0;
      opacity: 0;
      animation-play-state: paused;
      transition: opacity var(--dur-base) var(--ease-house);
      pointer-events: none;
    }

    .row a:hover .hover-burst,
    .row a:focus-visible .hover-burst {
      opacity: 1;
      animation-play-state: running;
    }

    .serial {
      color: var(--ash);
      font-size: var(--fs-000);
    }

    .meta h2 {
      font-size: var(--fs-2);
      font-weight: 300;
      margin-block: var(--sp-1);
    }

    .sub {
      color: var(--ash);
      font-size: var(--fs-000);
    }

    @media (max-width: 800px) {
      .layout {
        grid-template-columns: 1fr;
      }

      .filters {
        position: static;
        display: flex;
        overflow-x: auto;
      }

      .filters ul {
        flex-direction: row;
      }

      .row a {
        grid-template-columns: 6rem 1fr;
      }
    }
  </style>
</BaseLayout>
