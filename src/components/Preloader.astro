---
// Homepage-only initial load animation. Plays the sprite sheet if it's been
// dropped in, falls back to a static hold on the signature mark if only
// that exists, or renders nothing at all (straight to the page, no overlay)
// if neither is ready. Session-gated to once per visit and skippable on any
// input, same as the rest of the site's motion.
import { pixelArtExists, pixelArtPath, spriteFrameCount } from '../lib/pixelArt';

const frames = await spriteFrameCount('preloader.png');
const hasMark = !frames && pixelArtExists('mark.png');
---

{
  (frames || hasMark) && (
    <div class="preloader" data-preloader aria-hidden="true">
      {frames ? (
        <div
          class="preloader-sprite pixel-sprite pixel-art"
          style={`--frames:${frames}; --frame-steps:${frames - 1}; --sprite-duration:${frames * 90}ms; background-image:url(${pixelArtPath('preloader.png')})`}
        />
      ) : (
        <img
          class="preloader-mark pixel-art"
          src={pixelArtPath('mark.png')}
          alt=""
          width="40"
          height="80"
          onerror="this.closest('[data-preloader]')?.remove()"
        />
      )}
      <span class="preloader-bar" />
    </div>
  )
}

<script>
  const preloader = document.querySelector<HTMLElement>('[data-preloader]');
  if (preloader) {
    let seen = false;
    try {
      seen = sessionStorage.getItem('ocd-preloader-seen') === '1';
    } catch {
      /* ignore */
    }
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const markSeen = () => {
      try {
        sessionStorage.setItem('ocd-preloader-seen', '1');
      } catch {
        /* ignore */
      }
    };

    // Tells the hero intro (src/scripts/motion.ts) it can start. The data
    // attribute covers the case where this runs before that script loads.
    const announceIntro = () => {
      document.documentElement.dataset.intro = 'done';
      window.dispatchEvent(new Event('ocd:intro'));
    };

    if (seen || reduced) {
      preloader.remove();
      markSeen();
      announceIntro();
    } else {
      let dismissed = false;
      const dismiss = () => {
        if (dismissed) return;
        dismissed = true;
        clearTimeout(holdTimer);
        preloader.classList.add('fade-out');
        markSeen();
        announceIntro();
        setTimeout(() => preloader.remove(), 220);
      };
      const holdTimer = setTimeout(dismiss, 650);
      const events: (keyof WindowEventMap)[] = ['pointerdown', 'keydown', 'wheel', 'touchstart'];
      events.forEach((ev) => window.addEventListener(ev, dismiss, { once: true, passive: true }));
    }
  }
</script>

<style>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--sp-3);
    background: var(--ink);
    opacity: 1;
    transition: opacity var(--dur-base) var(--ease-precise);
  }

  .preloader.fade-out {
    opacity: 0;
  }

  .preloader-sprite {
    width: 64px;
    height: 64px;
  }

  /* 40x80 = 2x mark.png's 20x40 source canvas — integer scale, per
     ASSETS-TO-DRAW.md (matches Nav/Footer's 1x usage at 20x40). */
  .preloader-mark {
    width: 40px;
    height: 80px;
  }

  /* Hairline that fills across the 650ms hold, so the wait reads as
     progress rather than a stall. */
  .preloader-bar {
    width: 4rem;
    height: 1px;
    background: var(--line);
    background-image: linear-gradient(var(--paper), var(--paper));
    background-repeat: no-repeat;
    background-size: 0% 100%;
    animation: preloader-fill 600ms var(--ease-precise) forwards;
  }

  :global([dir='rtl']) .preloader-bar {
    background-position: right;
  }

  @keyframes preloader-fill {
    to {
      background-size: 100% 100%;
    }
  }
</style>
