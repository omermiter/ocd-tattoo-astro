---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import { getDict, type Locale } from '../../i18n';
import { placementLabel } from '../../lib/placements';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);

const flash = await getCollection('flash');
const retired = flash
  .filter((f) => f.data.status === 'retired')
  .sort((a, b) => (a.data.claimedDate < b.data.claimedDate ? 1 : -1));

const columns = [
  { key: 'serial', label: t.register.colSerial },
  { key: 'claimedDate', label: t.register.colClaimed },
  { key: 'claimedCity', label: t.register.colCity },
  { key: 'placement', label: t.register.colPlacement },
] as const;
---

<BaseLayout locale={locale} title={`${t.register.title} — OCD Tattoo`} description={t.register.subtitle}>
  <Nav locale={locale} active="register" />

  <main class="register">
    <header class="register-head">
      <h1>{t.register.title}</h1>
      <p class="subtitle">{t.register.subtitle}</p>
    </header>

    {
      retired.length === 0 ? (
        <p class="empty mono">{t.register.empty}</p>
      ) : (
        <table class="ledger mono" data-sortable>
          <thead>
            <tr>
              {columns.map((c) => (
                <th data-key={c.key} data-dir="none" tabindex="0" role="button">
                  {c.label}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {retired.map((r) => {
              const city = locale === 'he' ? r.data.claimedCity_he : r.data.claimedCity_en;
              const placement = placementLabel(r.data.placementSuggested[0] ?? '', locale);
              return (
                <tr
                  data-serial={r.data.serial}
                  data-claimeddate={r.data.claimedDate}
                  data-claimedcity={city}
                  data-placement={placement}
                >
                  <td>{r.data.serial}</td>
                  <td>{r.data.claimedDate}</td>
                  <td>{city}</td>
                  <td>{placement}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      )
    }
  </main>

  <Footer locale={locale} />

  <script>
    const table = document.querySelector<HTMLTableElement>('[data-sortable]');
    if (table) {
      const tbody = table.querySelector('tbody');
      const headers = table.querySelectorAll<HTMLElement>('th[data-key]');

      headers.forEach((th) => {
        const sort = () => {
          const key = th.dataset.key!;
          const current = th.dataset.dir ?? 'none';
          const next = current === 'asc' ? 'desc' : 'asc';
          headers.forEach((h) => (h.dataset.dir = 'none'));
          th.dataset.dir = next;

          const rows = Array.from(tbody?.querySelectorAll('tr') ?? []);
          const attr = `data-${key.toLowerCase()}`;
          rows.sort((a, b) => {
            const av = a.getAttribute(attr) ?? '';
            const bv = b.getAttribute(attr) ?? '';
            return next === 'asc' ? av.localeCompare(bv) : bv.localeCompare(av);
          });
          rows.forEach((row) => tbody?.appendChild(row));
        };
        th.addEventListener('click', sort);
        th.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            sort();
          }
        });
      });
    }
  </script>

  <style>
    .register {
      max-width: var(--content-max);
      margin-inline: auto;
      padding: var(--sp-4) var(--sp-3);
    }

    .register-head {
      border-block-end: var(--border-hairline);
      padding-block-end: var(--sp-3);
      margin-block-end: var(--sp-4);
    }

    .register-head h1 {
      font-size: var(--fs-display-sm);
    }

    .subtitle {
      color: var(--ash);
      margin-block-start: var(--sp-1);
    }

    .empty {
      color: var(--ash);
    }

    .ledger {
      width: 100%;
      border-collapse: collapse;
      font-size: var(--fs-00);
    }

    .ledger th,
    .ledger td {
      text-align: start;
      padding: var(--sp-1) var(--sp-2);
      border-block-end: var(--border-hairline);
    }

    .ledger th {
      color: var(--ash);
      cursor: pointer;
      user-select: none;
      font-weight: 400;
    }

    .ledger th[data-dir='asc']::after {
      content: ' ↑';
      color: var(--transfer);
    }

    .ledger th[data-dir='desc']::after {
      content: ' ↓';
      color: var(--transfer);
    }

    .ledger td {
      color: var(--pewter);
    }

    .ledger td:first-child {
      color: var(--bone);
    }
  </style>
</BaseLayout>
