---
import { Picture } from 'astro:assets';

interface Props {
  freshSrc: ImageMetadata;
  healedSrc: ImageMetadata;
  freshLabel: string;
  healedLabel: string;
  dragHint: string;
  alt: string;
}

const { freshSrc, healedSrc, freshLabel, healedLabel, dragHint, alt } = Astro.props;
---

<div class="scrubber" data-scrubber>
  <div class="frame" data-frame>
    <Picture
      class="layer"
      src={healedSrc}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[480, 900, 1400]}
      sizes="(min-width: 900px) 60vw, 100vw"
    />
    <div class="clip" data-clip>
      <Picture
        class="layer"
        src={freshSrc}
        alt=""
        formats={['avif', 'webp']}
        widths={[480, 900, 1400]}
        sizes="(min-width: 900px) 60vw, 100vw"
      />
    </div>
    <div
      class="handle"
      data-handle
      role="slider"
      tabindex="0"
      aria-label={dragHint}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="50"
      aria-orientation="horizontal"
    >
      <span class="grip" aria-hidden="true"></span>
    </div>
    <span class="tag tag-fresh mono" aria-hidden="true">{freshLabel}</span>
    <span class="tag tag-healed mono" aria-hidden="true">{healedLabel}</span>
  </div>
  <p class="hint mono">{dragHint}</p>
</div>

<script>
  function initScrubber(root: HTMLElement) {
    const frame = root.querySelector<HTMLElement>('[data-frame]');
    const clip = root.querySelector<HTMLElement>('[data-clip]');
    const handle = root.querySelector<HTMLElement>('[data-handle]');
    if (!frame || !clip || !handle) return;

    let dragging = false;

    const setPercent = (p: number) => {
      const percent = Math.min(100, Math.max(0, p));
      const rtl = getComputedStyle(frame).direction === 'rtl';
      const remainder = 100 - percent;
      clip.style.clipPath = rtl
        ? `inset(0 0 0 ${remainder}%)`
        : `inset(0 ${remainder}% 0 0)`;
      handle.style.insetInlineStart = `${percent}%`;
      handle.setAttribute('aria-valuenow', String(Math.round(percent)));
    };

    const percentFromEvent = (clientX: number) => {
      const rect = frame.getBoundingClientRect();
      const rtl = getComputedStyle(frame).direction === 'rtl';
      const fraction = rtl
        ? (rect.right - clientX) / rect.width
        : (clientX - rect.left) / rect.width;
      return fraction * 100;
    };

    setPercent(50);

    frame.addEventListener('pointerdown', (e) => {
      dragging = true;
      frame.setPointerCapture(e.pointerId);
      setPercent(percentFromEvent(e.clientX));
    });
    frame.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      setPercent(percentFromEvent(e.clientX));
    });
    const stop = () => {
      dragging = false;
    };
    frame.addEventListener('pointerup', stop);
    frame.addEventListener('pointercancel', stop);

    handle.addEventListener('keydown', (e) => {
      const current = Number(handle.getAttribute('aria-valuenow') ?? '50');
      const step = e.shiftKey ? 10 : 4;
      if (e.key === 'ArrowRight' || e.key === 'ArrowUp') {
        e.preventDefault();
        setPercent(current + step);
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') {
        e.preventDefault();
        setPercent(current - step);
      } else if (e.key === 'Home') {
        e.preventDefault();
        setPercent(0);
      } else if (e.key === 'End') {
        e.preventDefault();
        setPercent(100);
      }
    });
  }

  document.querySelectorAll<HTMLElement>('[data-scrubber]').forEach(initScrubber);
</script>

<style>
  .scrubber {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    touch-action: none;
    cursor: ew-resize;
    border-radius: var(--radius-image);
  }

  .layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .clip {
    position: absolute;
    inset: 0;
  }

  .handle {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 50%;
    width: 2px;
    background: var(--transfer);
    transform: translateX(-50%);
    cursor: ew-resize;
  }

  .grip {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    transform: translate(-50%, -50%);
    width: 2.5rem;
    height: 2.5rem;
    border: var(--border-hairline);
    border-color: var(--transfer);
    background: var(--ink);
  }

  .tag {
    position: absolute;
    inset-block-end: var(--sp-2);
    font-size: var(--fs-000);
    color: var(--bone);
    background: color-mix(in srgb, var(--ink) 70%, transparent);
    padding: 0.2rem 0.5rem;
  }

  .tag-fresh {
    inset-inline-start: var(--sp-2);
  }

  .tag-healed {
    inset-inline-end: var(--sp-2);
  }

  .hint {
    color: var(--ash);
    font-size: var(--fs-000);
  }
</style>
