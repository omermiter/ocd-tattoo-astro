---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { pixelArtExists, pixelArtPath } from '../lib/pixelArt';
import { isAssetMissing, getAsset } from '../lib/placeholders';
import PixelPlaceholder from '../components/PixelPlaceholder.astro';

const hasIllustration = pixelArtExists('404.png');
const illustrationAsset = getAsset('404');
---

<BaseLayout title="Page not found — OCD Tattoo" description="This page doesn't exist, or the piece moved.">
  <Nav />

  <main class="not-found grid-texture" data-reveal>
    {
      hasIllustration ? (
        <img
          class="illustration pixel-art"
          src={pixelArtPath('404.png')}
          alt="Page not found"
          loading="lazy"
          onerror="this.remove()"
        />
      ) : isAssetMissing('404') ? (
        <PixelPlaceholder id="404" width={illustrationAsset.width} height={illustrationAsset.height} label="404 illustration" />
      ) : (
        <p class="data code">404</p>
      )
    }
    <h1>Page not found.</h1>
    <p class="intro">This page doesn't exist, or the piece moved.</p>
    <a class="back data underline" href="/pieces/">← Back to Pieces</a>
  </main>

  <Footer />

  <style>
    .not-found {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: var(--sp-2);
      min-block-size: 60vh;
      padding: var(--sp-6) var(--sp-3);
    }

    .illustration {
      max-width: 16rem;
      height: auto;
      margin-block-end: var(--sp-2);
    }

    .code {
      color: var(--dust);
      font-size: var(--fs-3);
    }

    .not-found h1 {
      font-size: var(--fs-display-sm);
    }

    .intro {
      color: var(--dust);
    }

    .back {
      margin-block-start: var(--sp-2);
      color: var(--violet-ui);
      text-transform: uppercase;
    }
  </style>
</BaseLayout>
