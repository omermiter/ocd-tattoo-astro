---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { pixelArtExists, pixelArtPath } from '../lib/pixelArt';
import { isAssetMissing, getAsset } from '../lib/placeholders';
import PixelPlaceholder from '../components/PixelPlaceholder.astro';
import site from '../data/site.json';

const hasIllustration = pixelArtExists('404.png');
const illustrationAsset = getAsset('404');
const illustrationMissing = isAssetMissing('404');
const { code, heading, intro } = site.notFoundPage;
---

<BaseLayout title="Page not found — OCD Tattoo" description={intro}>
  <Nav />

  <main class="not-found" data-reveal>
    {
      hasIllustration ? (
        <img class="illustration pixel-art" src={pixelArtPath('404.png')} alt="" loading="lazy" onerror="this.remove()" />
      ) : illustrationMissing ? (
        <PixelPlaceholder id="404" width={illustrationAsset.width} height={illustrationAsset.height} label="404 illustration (fullscreen bg)" fill />
      ) : (
        <div class="grid-texture illustration-fallback" aria-hidden="true" />
      )
    }
    <div class="scrim" aria-hidden="true" />

    <div class="content">
      <p class="data code">{code}</p>
      <h1>{heading}</h1>
      <p class="intro">{intro}</p>
      <a class="back data underline" href="/pieces/">← Back to Pieces</a>
    </div>
  </main>

  <Footer />

  <style>
    .not-found {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      min-block-size: 100vh;
      padding: var(--sp-6) var(--sp-3);
      overflow: hidden;
    }

    /* Fullscreen background layer — the real illustration, the loud
       placeholder standing in for it, or (if the asset is deliberately
       skipped rather than just not-yet-drawn) the site's grid-texture
       motif as a quiet fallback. All three fill the same box. */
    .illustration,
    .illustration-fallback {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      /* Deliberate exception to "integer scaling only": this is a
         full-bleed scene behind text, not a detail-critical icon, and no
         single source resolution divides cleanly into every viewport
         width. Smooth-scaled like the hero photo, not pixelated — see
         ASSETS-TO-DRAW.md's 404.png entry. */
    }

    /* Dark gradient so the heading stays readable over whatever's behind
       it — same technique as the homepage hero. */
    .scrim {
      position: absolute;
      inset: 0;
      background-image: linear-gradient(180deg, rgba(18, 14, 23, 0.55), rgba(18, 14, 23, 0.88));
    }

    .content {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--sp-2);
    }

    .code {
      color: var(--dust);
      font-size: var(--fs-3);
    }

    .not-found h1 {
      font-size: var(--fs-display-sm);
    }

    .intro {
      color: var(--dust);
    }

    .back {
      margin-block-start: var(--sp-2);
      color: var(--violet-ui);
      text-transform: uppercase;
    }
  </style>
</BaseLayout>
