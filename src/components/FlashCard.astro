---
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import { getDict, type Locale } from '../i18n';
import { claimLink } from '../lib/whatsapp';
import { pixelArtExists, pixelArtPath } from '../lib/pixelArt';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'flash'>;
}

const { locale, entry } = Astro.props;
const t = getDict(locale);
const d = entry.data;
const title = locale === 'he' ? d.title_he : d.title_en;
const wa = claimLink(locale, d.serial);

// The stamp is a decorative reinforcement of the status already spelled out
// in the mono badge below (t.flash.available / t.flash.retired) — empty alt
// so screen readers don't announce the same status twice.
const stampFile = d.status === 'available' ? 'stamp-available.png' : d.status === 'retired' ? 'stamp-claimed.png' : null;
const hasStamp = stampFile ? pixelArtExists(stampFile) : false;
---

<li class={`flash-card status-${d.status}`} data-flash data-status={d.status} data-serial={d.serial}>
  <div class="art">
    {
      d.status !== 'sealed' && (
        <Picture
          src={d.image}
          alt={title}
          formats={['avif', 'webp']}
          widths={[300, 600, 900]}
          sizes="(min-width: 900px) 24vw, 45vw"
        />
      )
    }
    {
      d.status === 'available' && (
        <div
          class="stencil-layer"
          data-stencil-layer
          tabindex="0"
          role="button"
          aria-pressed="false"
          aria-label={t.flash.liftInstruction}
        >
          <span class="grain" aria-hidden="true" />
        </div>
      )
    }
  </div>

  <div class="card-meta mono">
    <span class="serial">{d.serial}</span>
    {
      d.status === 'retired' ? (
        <span class="retired-meta">
          {locale === 'he' ? d.claimedCity_he : d.claimedCity_en} · {d.claimedDate}
        </span>
      ) : (
        <span class="size">{d.approxSize}</span>
      )
    }
  </div>

  {
    d.status === 'sealed' && <span class="badge mono">{t.flash.sealed}</span>
  }
  {
    d.status === 'retired' && <span class="badge mono">{t.flash.retired}</span>
  }
  {
    hasStamp && stampFile && (
      <img
        class="pixel-stamp pixel-art"
        src={pixelArtPath(stampFile)}
        alt=""
        width="96"
        height="48"
        loading="lazy"
        onerror="this.remove()"
      />
    )
  }

  {
    d.status === 'available' && (
      <div class="claim-wrap" data-claim-wrap hidden>
        <button class="claim-cta mono" data-claim type="button">
          {t.flash.claimCta}
        </button>
        <div class="confirm" data-confirm hidden>
          <p class="confirm-title mono">{t.flash.confirmTitle}</p>
          <p class="confirm-body">{t.flash.confirmBody}</p>
          <a class="wa mono" href={wa} target="_blank" rel="noopener noreferrer">
            {t.flash.whatsappCta} →
          </a>
        </div>
      </div>
    )
  }
</li>

<style>
  .flash-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    border: var(--border-hairline);
    border-color: var(--graphite);
    padding: var(--sp-2);
  }

  .status-sealed,
  .status-available {
    border-color: var(--stencil);
  }

  .art {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--carbon);
  }

  .art :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .status-retired .art :global(img) {
    filter: grayscale(0.85) brightness(0.75);
  }

  .status-sealed .art {
    background:
      repeating-linear-gradient(
        45deg,
        var(--stencil) 0px,
        var(--stencil) 2px,
        var(--carbon) 2px,
        var(--carbon) 10px
      );
  }

  .stencil-layer {
    position: absolute;
    inset: 0;
    cursor: grab;
    background:
      repeating-linear-gradient(
        45deg,
        var(--stencil) 0px,
        var(--stencil) 2px,
        color-mix(in srgb, var(--stencil) 60%, var(--ink)) 2px,
        color-mix(in srgb, var(--stencil) 60%, var(--ink)) 10px
      );
    transition: clip-path var(--dur-slow) var(--ease-house);
    clip-path: inset(0 0 0 0);
  }

  .flash-card[data-lifted='true'] .stencil-layer {
    clip-path: inset(0 100% 0 0);
    pointer-events: none;
  }

  [dir='rtl'] .flash-card[data-lifted='true'] .stencil-layer {
    clip-path: inset(0 0 0 100%);
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    font-size: var(--fs-000);
    color: var(--bone);
  }

  .retired-meta,
  .size {
    color: var(--ash);
  }

  .badge {
    font-size: var(--fs-000);
    color: var(--transfer);
  }

  .status-retired .badge {
    color: var(--ash);
  }

  .claim-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .claim-wrap[hidden] {
    display: none;
  }

  .claim-cta {
    cursor: pointer;
    text-align: start;
    font-size: var(--fs-000);
    color: var(--transfer);
    padding-block: var(--sp-1);
  }

  .confirm {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    padding-block-start: var(--sp-1);
    border-block-start: var(--border-hairline);
  }

  .confirm[hidden] {
    display: none;
  }

  .confirm-title {
    color: var(--bone);
    font-size: var(--fs-000);
  }

  .confirm-body {
    font-size: var(--fs-000);
    color: var(--pewter);
    margin: 0;
  }

  .wa {
    color: var(--transfer);
    text-decoration: none;
    font-size: var(--fs-000);
  }

  .pixel-stamp {
    align-self: flex-end;
    width: 64px;
    height: 32px;
  }
</style>

<script>
  function setupFlashCard(card: HTMLElement) {
    const serial = card.dataset.serial ?? '';
    const status = card.dataset.status;
    const key = `ocd-lifted-${serial}`;

    const applyLifted = (lifted: boolean) => {
      card.dataset.lifted = String(lifted);
      const layer = card.querySelector<HTMLElement>('[data-stencil-layer]');
      layer?.setAttribute('aria-pressed', String(lifted));
      const wrap = card.querySelector<HTMLElement>('[data-claim-wrap]');
      if (wrap) wrap.hidden = !lifted;
    };

    if (status === 'available') {
      let lifted = false;
      try {
        lifted = localStorage.getItem(key) === '1';
      } catch {
        /* ignore */
      }
      applyLifted(lifted);

      const layer = card.querySelector<HTMLElement>('[data-stencil-layer]');
      if (layer && !lifted) {
        let dragging = false;
        let percent = 0;

        const setPercent = (p: number) => {
          percent = Math.min(100, Math.max(0, p));
          const rtl = getComputedStyle(card).direction === 'rtl';
          const remainder = 100 - percent;
          layer.style.transition = 'none';
          layer.style.clipPath = rtl
            ? `inset(0 0 0 ${remainder}%)`
            : `inset(0 ${remainder}% 0 0)`;
        };

        const settle = () => {
          layer.style.transition = '';
          if (percent > 50) {
            try {
              localStorage.setItem(key, '1');
            } catch {
              /* ignore */
            }
            applyLifted(true);
          } else {
            layer.style.clipPath = '';
            percent = 0;
          }
        };

        const percentFromEvent = (clientX: number) => {
          const rect = layer.getBoundingClientRect();
          const rtl = getComputedStyle(card).direction === 'rtl';
          const fraction = rtl
            ? (rect.right - clientX) / rect.width
            : (clientX - rect.left) / rect.width;
          return fraction * 100;
        };

        layer.addEventListener('pointerdown', (e) => {
          dragging = true;
          layer.setPointerCapture(e.pointerId);
          setPercent(percentFromEvent(e.clientX));
        });
        layer.addEventListener('pointermove', (e) => {
          if (!dragging) return;
          setPercent(percentFromEvent(e.clientX));
        });
        const stop = () => {
          if (!dragging) return;
          dragging = false;
          settle();
        };
        layer.addEventListener('pointerup', stop);
        layer.addEventListener('pointercancel', stop);

        layer.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowUp') {
            e.preventDefault();
            setPercent(percent + 20);
            settle();
          } else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') {
            e.preventDefault();
            setPercent(percent - 20);
            settle();
          } else if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            setPercent(100);
            settle();
          }
        });
      }

      const claimBtn = card.querySelector<HTMLButtonElement>('[data-claim]');
      const confirm = card.querySelector<HTMLElement>('[data-confirm]');
      claimBtn?.addEventListener('click', () => {
        if (confirm) confirm.hidden = !confirm.hidden;
      });
    }
  }

  document.querySelectorAll<HTMLElement>('[data-flash]').forEach(setupFlashCard);
</script>
