---
import { hasPhoto } from '../lib/media';
import { pixelArtPath, spriteFrameCount } from '../lib/pixelArt';

interface Props {
  photo?: string;
  serial: string;
  alt: string;
  ratio?: string;
}

const { photo, serial, alt, ratio = '4 / 5' } = Astro.props;
const available = photo ? hasPhoto(photo) : false;

// Hover-burst sprite only makes sense over real photography — only loads
// its bytes once the thumbnail scrolls into view (see the observer below),
// and only plays on hover/focus. Skipped entirely if the sheet isn't ready.
const hoverBurstFrames = available ? await spriteFrameCount('hover-burst.png') : null;
const hoverBurstSrc = hoverBurstFrames ? pixelArtPath('hover-burst.png') : null;
---

<div class="piece-media" class:list={[{ pending: !available }]} style={available ? `aspect-ratio: ${ratio}` : undefined}>
  {
    available && photo ? (
      <Fragment>
        <img src={photo} alt={alt} loading="lazy" />
        {hoverBurstFrames && hoverBurstSrc && (
          <span
            class="hover-burst pixel-sprite pixel-art"
            data-hover-burst
            data-src={hoverBurstSrc}
            style={`--frames:${hoverBurstFrames}; --frame-steps:${hoverBurstFrames - 1}`}
            aria-hidden="true"
          />
        )}
      </Fragment>
    ) : (
      <div class="pending-panel grid-texture" role="img" aria-label={`${alt} — not yet photographed`}>
        <span class="serial">{serial}</span>
        <span class="data pending-label">Photography pending</span>
      </div>
    )
  }
</div>

<script>
  const bursts = document.querySelectorAll<HTMLElement>('[data-hover-burst]');
  if (bursts.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const src = el.dataset.src;
          if (src) {
            const img = new Image();
            img.onload = () => {
              el.style.backgroundImage = `url(${src})`;
            };
            img.onerror = () => el.remove();
            img.src = src;
          }
          observer.unobserve(el);
        });
      },
      { rootMargin: '300px' },
    );
    bursts.forEach((el) => observer.observe(el));
  }
</script>

<style>
  .piece-media {
    position: relative;
    overflow: hidden;
    background: var(--surface);
    border: var(--border-hairline);
  }

  .piece-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-precise);
  }

  /* The photo lifts up within its own frame on hover, uncovering a strip of
     the frame's own background at the bottom where the burst plays — both
     effects stay inside the existing bordered box, nothing resizes. */
  .piece-media:hover img,
  .piece-media:focus-within img {
    transform: translateY(-64px);
  }

  /* Fixed square size, anchored to the bottom of the frame (the space the
     lifted photo just uncovered). background-size on .pixel-sprite is
     relative to this element's own box, so it must stay square itself or
     the frames stretch instead of scaling up cleanly. */
  .hover-burst {
    position: absolute;
    inset-block-end: var(--sp-1);
    inset-inline-start: 50%;
    width: 56px;
    aspect-ratio: 1;
    transform: translateX(-50%);
    opacity: 0;
    animation-play-state: paused;
    transition: opacity var(--dur-base) var(--ease-precise);
    pointer-events: none;
  }

  .piece-media:hover .hover-burst,
  .piece-media:focus-within .hover-burst {
    opacity: 1;
    animation-play-state: running;
  }

  /* A missing photo is treated as a deliberate specimen card, not an empty
     box waiting to be filled — capped height, real typographic weight, so
     it reads as "not photographed yet" rather than "unfinished template". */
  .piece-media.pending {
    aspect-ratio: unset;
  }

  .pending-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    padding: var(--sp-5) var(--sp-2);
  }

  .serial {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-display-sm);
    color: var(--dust);
  }

  .pending-label {
    text-transform: uppercase;
  }
</style>
