---
import type { CollectionEntry } from 'astro:content';
import PieceMedia from './PieceMedia.astro';
import { t, type Locale } from '../i18n/ui';

interface Props {
  entry: CollectionEntry<'pieces'>;
  locale?: Locale;
}

const { entry, locale = 'en' } = Astro.props;
const ui = t(locale);
const p = entry.data;
---

<article class="piece">
  <PieceMedia photo={p.photo} serial={p.serial} alt={p.title} locale={locale} />
  <div class="piece-meta">
    <span class="data serial">{p.serial}</span>
    <h2 data-split="scrub">{p.title}</h2>
    <dl class="data specs">
      <div>
        <dt>{ui.pieceCard.placement}</dt>
        <dd>{p.placement}</dd>
      </div>
      <div>
        <dt>{ui.pieceCard.size}</dt>
        <dd>{p.size}</dd>
      </div>
      <div>
        <dt>{ui.pieceCard.sessions}</dt>
        <dd>{p.sessions}</dd>
      </div>
      <div>
        <dt>{ui.pieceCard.hours}</dt>
        <dd>{p.hours}</dd>
      </div>
      <div>
        <dt>{ui.pieceCard.date}</dt>
        <dd>{p.date}</dd>
      </div>
    </dl>
    <p class="note">{p.note}</p>
  </div>
</article>

<style>
  .piece {
    display: grid;
    grid-template-columns: minmax(0, 26rem) minmax(0, 1fr);
    gap: var(--sp-4);
    align-items: start;
  }

  .piece-meta {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding-block-start: var(--sp-1);
  }

  .piece-meta .serial {
    color: var(--dust);
  }

  .piece-meta h2 {
    font-size: var(--fs-3);
  }

  .specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-1) var(--sp-3);
    margin: 0;
    border-block: var(--border-hairline);
    padding-block: var(--sp-2);
  }

  .specs div {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-2);
  }

  .specs dt {
    color: var(--dust);
  }

  .specs dd {
    margin: 0;
    color: var(--paper);
  }

  .note {
    color: var(--paper);
    max-width: 30rem;
    line-height: 1.6;
    /* Always English (see i18n/ui.ts — per-piece notes stay untranslated).
       `unicode-bidi: isolate` alone isn't enough here — it still resolves
       against the *inherited* `direction` (rtl on the Hebrew page), same
       as plain `isolate` on <bdi> without dir="auto": the trailing period
       reorders to the front, ".Steelix in full-color pixel art" instead of
       "Steelix in full-color pixel art." `direction: ltr` is what actually
       fixes the ordering; `text-align: right` keeps the block itself
       flush right so it still sits like the rest of the Hebrew card. */
    direction: ltr;
    unicode-bidi: isolate;
    text-align: right;
  }

  :global([dir='ltr']) .note {
    text-align: left;
  }

  @media (max-width: 800px) {
    .piece {
      grid-template-columns: 1fr;
    }
  }
</style>
