---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/pixel-art.css';
import Cursor from '../components/Cursor.astro';
import { pixelArtExists, pixelArtPath } from '../lib/pixelArt';
import { localePath, type Locale } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  /** Optional schema.org JSON-LD object, rendered verbatim in <head>. */
  structuredData?: Record<string, unknown>;
  locale?: Locale;
  /**
   * Path to this page's likely LCP image. The homepage hero sets it via a
   * CSS custom property (--heroBg, see HomePage.astro), which the HTML
   * preload scanner can't see — it only resolves url()/var() once the
   * stylesheet that uses it has downloaded and parsed. An explicit preload
   * link here is discoverable immediately, straight off the initial HTML.
   */
  preloadImage?: string;
}

const { title, description, structuredData, locale = 'en', preloadImage } = Astro.props;
const dir = locale === 'he' ? 'rtl' : 'ltr';

// The pixel-art favicon is additive, not a replacement: favicon.svg stays as
// the permanent fallback so the tab icon is never missing, and the
// hand-drawn one appears automatically once dropped in and rebuilt.
const hasPixelFavicon = pixelArtExists('favicon.png');
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    {hasPixelFavicon && <link rel="icon" href={pixelArtPath('favicon.png')} sizes="32x32" />}
    {preloadImage && <link rel="preload" as="image" fetchpriority="high" href={preloadImage} />}
    <meta name="description" content={description} />
    <title>{title}</title>
    <meta name="color-scheme" content="dark" />
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="alternate" hreflang="en" href={`https://ocdtattoo.com${localePath('en')}`} />
    <link rel="alternate" hreflang="he" href={`https://ocdtattoo.com${localePath('he')}`} />
    <link rel="alternate" hreflang="x-default" href={`https://ocdtattoo.com${localePath('en')}`} />
    {structuredData && <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />}
    <!-- Cloudflare Web Analytics — privacy-friendly (no cookies, no personal
         data). Stats live at dash.cloudflare.com → Analytics & Logs → Web
         Analytics. -->
    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "34c31e0adcca4b61b893e5ae41a28f17"}'
    ></script>
  </head>
  <body>
    <Cursor />
    <slot />
  </body>

  <script>
    // Global scroll-reveal: any element marked data-reveal fades/rises in
    // once, the moment it crosses into view. Runs on every page from here
    // rather than being duplicated per-page.
    const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduced) {
      els.forEach((el) => el.classList.add('is-visible'));
    } else if (els.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
      );
      els.forEach((el) => observer.observe(el));
    }
  </script>
</html>

