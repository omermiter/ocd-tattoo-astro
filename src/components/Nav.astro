---
import { isAssetMissing, getAsset } from '../lib/placeholders';
import PixelPlaceholder from './PixelPlaceholder.astro';
import { pixelArtExists, pixelArtPath } from '../lib/pixelArt';
import { t, localePath, type Locale } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const ui = t(locale);
const otherLocale: Locale = locale === 'en' ? 'he' : 'en';

// Split into two clusters, matching the reference nav's structure: the
// section links pipe-divided in the center, Contact + the language switch
// set apart on the far end with extra space — not just another link in the
// row.
const mainLinks = [
  { key: 'pieces', label: ui.nav.pieces, href: '#pieces' },
  { key: 'reviews', label: ui.nav.reviews, href: '#reviews' },
] as const;

const markMissing = isAssetMissing('mark');
const markAsset = getAsset('mark');
const hasMark = pixelArtExists('mark.png');
---

<nav class="nav">
  <a class="brand" href={localePath(locale)}>
    {
      hasMark ? (
        <img class="brand-mark pixel-art" src={pixelArtPath('mark.png')} alt="" width={markAsset.width} height={markAsset.height} />
      ) : (
        markMissing && <PixelPlaceholder id="mark" width={markAsset.width} height={markAsset.height} label="mark" />
      )
    }
    <span class="data">OCD·TATTOO</span>
  </a>

  <span class="connector" aria-hidden="true"></span>

  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-panel" aria-label={ui.nav.menu}>
    <span></span>
  </button>

  <div class="panel" id="nav-panel">
    <ul class="links data">
      {
        mainLinks.map((l) => (
          <li>
            <a class="underline" href={l.href}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <ul class="links links-end data">
      <li>
        <a class="underline contact" href="#contact">
          {ui.nav.contact}
        </a>
      </li>
      <li>
        <a class="underline lang-switch" href={localePath(otherLocale)} hreflang={otherLocale} lang={otherLocale} dir={otherLocale === 'he' ? 'rtl' : 'ltr'}>
          {ui.nav.switchTo}
        </a>
      </li>
    </ul>
  </div>
</nav>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const panel = document.querySelector<HTMLElement>('#nav-panel');
  if (toggle && panel) {
    const close = () => {
      toggle.setAttribute('aria-expanded', 'false');
      panel.removeAttribute('data-open');
    };
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      if (open) panel.removeAttribute('data-open');
      else panel.setAttribute('data-open', 'true');
    });
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }
</script>

<style>
  .nav {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--sp-2) var(--sp-3);
    border-block-end: var(--border-hairline);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    text-decoration: none;
    letter-spacing: 0.1em;
    color: var(--paper);
  }

  /* 20x40 = 1x mark.png's actual source canvas — integer scale, per
     ASSETS-TO-DRAW.md. Never display this smaller/larger at a fraction. */
  .brand-mark {
    width: 20px;
    height: 40px;
  }

  .brand :global([data-placeholder]) {
    width: 20px;
    height: 40px;
  }

  /* Thin rule connecting the brand mark to the links, borrowed from the
     reference nav's logo-to-links divider. Desktop only — on mobile the
     links move into the dropdown panel and this would just be dead space. */
  .connector {
    flex: 1;
    height: 1px;
    background: var(--line);
    margin-inline: var(--sp-3);
  }

  .menu-toggle {
    display: none;
    width: 20px;
    height: 14px;
    position: relative;
    cursor: pointer;
  }

  .menu-toggle span,
  .menu-toggle span::before,
  .menu-toggle span::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--paper);
  }

  .menu-toggle span {
    top: 6px;
  }

  .menu-toggle span::before {
    top: -6px;
  }

  .menu-toggle span::after {
    top: 6px;
  }

  .panel {
    display: contents;
  }

  .links {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    text-transform: uppercase;
  }

  /* Pipe-divided links, matching the reference nav's link row — a hairline
     rather than a literal "|" glyph, consistent with how the rest of the
     site already draws dividers (feature strip, spec-sheet cards). */
  .links li {
    padding-inline: var(--sp-3);
    border-inline-start: var(--border-hairline);
  }

  .links li:first-child {
    padding-inline-start: 0;
    border-inline-start: none;
  }

  /* The set-apart cluster (Contact + language switch), pushed away from
     the main links with real space — same device as the reference nav
     separating O NAS / KONTAKT from the main link row. */
  .links-end {
    margin-inline-start: var(--sp-4);
  }

  .links a {
    text-decoration: none;
    color: var(--dust);
    transition: color var(--dur-base) var(--ease-precise);
  }

  .links a:hover {
    color: var(--paper);
  }

  /* Contact is the one action every other section funnels toward — --claim
     is reserved for it alone, so it reads as the site's standing CTA
     rather than a third equal nav item. Same color family as every other
     CTA on the site — see REDESIGN-PLAN.md §2. */
  .links a.contact {
    color: var(--claim);
  }

  .links a.contact:hover {
    color: var(--paper);
  }

  @media (max-width: 640px) {
    .connector {
      display: none;
    }

    .menu-toggle {
      display: block;
    }

    .panel {
      display: block;
      position: absolute;
      inset-inline: 0;
      top: 100%;
      background: var(--ink);
      border-block-end: var(--border-hairline);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity var(--dur-base) var(--ease-precise),
        visibility var(--dur-base) var(--ease-precise);
      z-index: 20;
    }

    .panel[data-open] {
      opacity: 1;
      visibility: visible;
    }

    .links {
      flex-direction: column;
    }

    /* Pipe dividers only make sense in a horizontal row — reset them here
       in favor of the existing stacked/full-width mobile link style. */
    .links li {
      padding-inline: 0;
      border-inline-start: none;
    }

    .links-end {
      margin-inline-start: 0;
    }

    .links a {
      display: block;
      padding: var(--sp-2) var(--sp-3);
      border-block-end: var(--border-hairline);
    }
  }
</style>
