---
import { hasPhoto } from '../lib/media';

interface Props {
  photo?: string;
  serial: string;
  alt: string;
  ratio?: string;
}

const { photo, serial, alt, ratio = '4 / 5' } = Astro.props;
const available = photo ? hasPhoto(photo) : false;
---

<div class="piece-media" class:list={[{ pending: !available }]} style={available ? `aspect-ratio: ${ratio}` : undefined}>
  {
    available && photo ? (
      <img src={photo} alt={alt} loading="lazy" />
    ) : (
      <div class="pending-panel grid-texture" role="img" aria-label={`${alt} — not yet photographed`}>
        <span class="serial">{serial}</span>
        <span class="data pending-label">Photography pending</span>
      </div>
    )
  }
</div>

<style>
  .piece-media {
    overflow: hidden;
    background: var(--surface);
    border: var(--border-hairline);
  }

  .piece-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* A missing photo is treated as a deliberate specimen card, not an empty
     box waiting to be filled — capped height, real typographic weight, so
     it reads as "not photographed yet" rather than "unfinished template". */
  .piece-media.pending {
    aspect-ratio: unset;
  }

  .pending-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    padding: var(--sp-5) var(--sp-2);
  }

  .serial {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-display-sm);
    color: var(--dust);
  }

  .pending-label {
    text-transform: uppercase;
  }
</style>
