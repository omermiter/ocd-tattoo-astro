---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PieceCard from '../../components/PieceCard.astro';
import { hasPhoto } from '../../lib/media';

const pieces = (await getCollection('pieces')).sort((a, b) => (a.data.serial < b.data.serial ? -1 : 1));
// Only entries with a real photo on disk render — same graceful-absence
// convention as PieceMedia, but simpler: a gallery entry with no photo yet
// has nothing else worth showing, so it's skipped rather than placeheld.
const restOfWorks = (await getCollection('gallery')).filter((g) => hasPhoto(g.data.photo));
---

<BaseLayout
  title="Pieces — OCD Tattoo"
  description="Color pixel art tattoos, precision-built one at a time. Every piece documented: placement, sessions, hours, and the artist's own notes on execution."
>
  <Nav active="pieces" />

  <main class="page">
    <header class="page-head" data-reveal>
      <p class="eyebrow">Pieces</p>
      <h1>A growing collection, built one at a time.</h1>
      <p class="intro">
        Not a portfolio in the volume sense — a record. Each piece below is documented in full:
        placement, time, and what the execution actually required.
      </p>
    </header>

    <div class="piece-list">
      {pieces.map((p) => <div data-reveal><PieceCard entry={p} /></div>)}
    </div>

    {
      restOfWorks.length > 0 && (
        <section class="rest-of-works" data-reveal>
          <h2>Rest of the works</h2>
          <div class="rest-grid">
            {restOfWorks.map((g) => (
              <figure class="rest-item">
                <img src={g.data.photo} alt={g.data.title} loading="lazy" />
                <figcaption class="data">{g.data.title}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <section class="closing" data-reveal>
      <h2>Want something like this?</h2>
      <p class="subhead">Every commission starts the same way — tell me the idea and the placement.</p>
      <a class="cta data underline" href="/contact/">Start a commission →</a>
    </section>
  </main>

  <Footer />

  <style>
    .page {
      max-width: var(--content-max);
      margin-inline: auto;
      padding: var(--sp-6) var(--sp-3);
    }

    .page-head {
      display: flex;
      flex-direction: column;
      gap: var(--sp-2);
      max-width: 40rem;
      margin-block-end: var(--sp-6);
    }

    .page-head .eyebrow {
      text-transform: uppercase;
    }

    .page-head h1 {
      font-size: var(--fs-display-md);
    }

    .intro {
      color: var(--dust);
      font-size: var(--fs-2);
      line-height: 1.5;
    }

    .piece-list {
      display: flex;
      flex-direction: column;
      gap: var(--sp-7);
    }

    .rest-of-works {
      margin-block-start: var(--sp-7);
      padding-block-start: var(--sp-6);
      border-block-start: var(--border-hairline);
    }

    .rest-of-works h2 {
      font-size: var(--fs-display-sm);
      margin-block-end: var(--sp-3);
    }

    .rest-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
      gap: var(--sp-3);
    }

    .rest-item img {
      width: 100%;
      aspect-ratio: 1;
      object-fit: cover;
      display: block;
      background: var(--surface);
      border: var(--border-hairline);
    }

    .rest-item figcaption {
      margin-block-start: var(--sp-1);
      color: var(--dust);
      font-size: var(--fs-00);
    }

    .closing {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--sp-2);
      margin-block-start: var(--sp-7);
      padding-block-start: var(--sp-6);
      border-block-start: var(--border-hairline);
    }

    .closing h2 {
      font-size: var(--fs-display-sm);
    }

    .subhead {
      max-width: 30rem;
      color: var(--dust);
      font-size: var(--fs-2);
    }

    .cta {
      color: var(--claim);
      text-transform: uppercase;
    }
  </style>
</BaseLayout>
