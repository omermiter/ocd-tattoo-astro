---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import HealedScrubber from '../HealedScrubber.astro';
import Countdown from '../Countdown.astro';
import PixelDivider from '../PixelDivider.astro';
import { getDict, type Locale } from '../../i18n';
import { pagePath, otherLocale } from '../../lib/paths';
import { placementLabel } from '../../lib/placements';
import { pixelArtExists, pixelArtPath, spriteFrameCount } from '../../lib/pixelArt';

// Preloader: plays the animated sprite if it's been dropped in, falls back to
// a static hold on the signature mark if only that exists, or is skipped
// entirely (straight into the existing hero sequence below) if neither
// asset is ready yet.
const preloaderFrames = await spriteFrameCount('preloader.png');
const hasPreloaderMark = !preloaderFrames && pixelArtExists('mark.png');

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDict(locale);

const metaTitle =
  locale === 'he' ? 'OCD Tattoo — ארכיון פיקסל ארט צבעוני' : 'OCD Tattoo — color pixel art archive';
const metaDescription =
  locale === 'he'
    ? 'ארכיון עבודות טאטו פיקסל ארט צבעוני. אזור השרון. עבודה בהתאמה אישית מוגשת בבקשה.'
    : 'A color pixel art tattoo archive. Sharon region, Israel. Custom work is applied for.';

const work = await getCollection('work');
const featured = work.find((w) => w.data.featured) ?? work[0];
const featuredTitle = locale === 'he' ? featured.data.title_he : featured.data.title_en;
const featuredPlacement = locale === 'he' ? featured.data.placement_he : featured.data.placement_en;
const featuredHealedAt = locale === 'he' ? featured.data.healedAt_he : featured.data.healedAt_en;

const flash = await getCollection('flash');
const retired = flash
  .filter((f) => f.data.status === 'retired')
  .sort((a, b) => (a.data.claimedDate < b.data.claimedDate ? 1 : -1))
  .slice(0, 3);

const nextDrop = flash
  .filter((f) => f.data.status === 'sealed')
  .map((f) => f.data.releaseAt)
  .sort()[0];
---

<BaseLayout locale={locale} title={metaTitle} description={metaDescription}>
  <Nav locale={locale} active="home" />

  <main>
  <section
    class="hero"
    data-intro
    data-locale={locale}
    data-other-home={pagePath(otherLocale(locale), '')}
  >
    {
      (preloaderFrames || hasPreloaderMark) && (
        <div class="preloader" data-preloader aria-hidden="true">
          {preloaderFrames ? (
            <div
              class="preloader-sprite pixel-sprite pixel-art"
              style={`--frames:${preloaderFrames}; --sprite-duration:${preloaderFrames * 90}ms; background-image:url(${pixelArtPath('preloader.png')})`}
            />
          ) : (
            <img
              class="preloader-mark pixel-art"
              src={pixelArtPath('mark.png')}
              alt=""
              width="64"
              height="64"
              onerror="this.closest('[data-preloader]')?.remove()"
            />
          )}
        </div>
      )
    }
    <div class="intro-line" data-intro-line></div>
    <div class="hero-photo">
      <Picture
        src={featured.data.images.healed}
        alt=""
        formats={['avif', 'webp']}
        widths={[640, 1200, 1920]}
        sizes="100vw"
      />
    </div>
    <h1 class="wordmark">OCD·TATTOO</h1>
    <button class="skip mono" data-skip-intro type="button">{t.home.skipIntro}</button>
  </section>

  <section class="proof">
    <HealedScrubber
      freshSrc={featured.data.images.fresh}
      healedSrc={featured.data.images.healed}
      freshLabel={t.home.freshLabel}
      healedLabel={t.home.healedLabel}
      dragHint={t.home.scrubberHint}
      alt={featuredTitle}
    />
    <dl class="spec mono">
      <div><dt>{t.dossier.placement}</dt><dd>{featuredPlacement}</dd></div>
      <div><dt>{t.dossier.stageHealed}</dt><dd>{featuredHealedAt}</dd></div>
      <div><dt>{t.dossier.date}</dt><dd class="ltr-num">{featured.data.dateRange}</dd></div>
      <div class="serial"><dt>{featured.data.serial}</dt></div>
    </dl>
  </section>

  <PixelDivider />

  <section class="doors">
    <a class="door commission" href={pagePath(locale, 'request')}>
      <h2>{t.home.commission.title}</h2>
      <p>{t.home.commission.body}</p>
      <span class="cta mono">{t.home.commission.cta} →</span>
    </a>
    <a class="door vault" href={pagePath(locale, 'flash')}>
      <h2>{t.home.vault.title}</h2>
      {
        nextDrop && (
          <p class="next-drop">
            <Countdown target={nextDrop} label={t.home.vault.nextDropLabel} />
          </p>
        )
      }
      <span class="cta mono">{t.home.vault.cta} →</span>
    </a>
  </section>

  <PixelDivider />

  <section class="ledger">
    <h2 class="mono ledger-title">{t.home.registerLatest}</h2>
    <ul class="ledger-list mono">
      {
        retired.map((r) => (
          <li>
            <span class="serial">{r.data.serial}</span>
            <span>{locale === 'he' ? r.data.claimedCity_he : r.data.claimedCity_en}</span>
            <span>{placementLabel(r.data.placementSuggested[0] ?? '', locale)}</span>
            <span>{r.data.claimedDate}</span>
          </li>
        ))
      }
    </ul>
  </section>
  </main>

  <Footer locale={locale} />

  <style>
    .hero {
      position: relative;
      display: grid;
      place-items: center;
      min-block-size: 70vh;
      overflow: hidden;
      text-align: center;
    }

    .preloader {
      position: fixed;
      inset: 0;
      z-index: 10;
      display: grid;
      place-items: center;
      background: var(--ink);
      opacity: 1;
      transition: opacity var(--dur-base) var(--ease-house);
    }

    .preloader.fade-out {
      opacity: 0;
    }

    .preloader-sprite {
      width: 64px;
      height: 64px;
    }

    .preloader-mark {
      width: 64px;
      height: 64px;
    }

    .intro-line {
      position: absolute;
      inset-block-start: 0;
      inset-inline: 0;
      height: 0.5px;
      background: var(--graphite);
      z-index: 2;
    }

    .hero-photo {
      position: absolute;
      inset: 0;
    }

    .hero-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0.2;
      border-radius: 0;
    }

    .wordmark {
      position: relative;
      font-size: var(--fs-display-lg);
      letter-spacing: 0.02em;
      z-index: 1;
    }

    .skip {
      position: absolute;
      inset-block-end: var(--sp-3);
      inset-inline-end: var(--sp-3);
      color: var(--ash);
      font-size: var(--fs-000);
      z-index: 2;
    }

    .proof {
      display: grid;
      grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
      gap: var(--sp-4);
      padding: var(--sp-5) var(--sp-3);
      max-width: var(--content-max);
      margin-inline: auto;
    }

    .spec {
      display: flex;
      flex-direction: column;
      gap: var(--sp-2);
      align-self: start;
      font-size: var(--fs-00);
      color: var(--ash);
    }

    .spec div {
      display: flex;
      justify-content: space-between;
      border-block-end: var(--border-hairline);
      padding-block-end: var(--sp-1);
    }

    .spec dt {
      margin: 0;
    }

    .spec dd {
      margin: 0;
      color: var(--pewter);
    }

    .spec .serial {
      color: var(--bone);
      border-block-end: none;
    }

    .doors {
      display: grid;
      grid-template-columns: 1.8fr 1fr;
      gap: var(--border-hairline);
      border-block: var(--border-hairline);
    }

    .door {
      display: flex;
      flex-direction: column;
      gap: var(--sp-2);
      padding: var(--sp-6) var(--sp-4);
      text-decoration: none;
      color: var(--pewter);
      transition: background var(--dur-base) var(--ease-house);
    }

    .door:hover {
      background: var(--carbon);
    }

    .door h2 {
      font-size: var(--fs-display-sm);
    }

    .door.vault {
      border-inline-start: var(--border-hairline);
    }

    .door.vault h2 {
      font-size: var(--fs-2);
      font-family: var(--font-mono);
      color: var(--stencil);
      font-weight: 400;
    }

    .next-drop {
      font-size: var(--fs-000);
    }

    .cta {
      font-size: var(--fs-000);
      color: var(--bone);
    }

    .ledger {
      padding: var(--sp-4) var(--sp-3);
      max-width: var(--content-max);
      margin-inline: auto;
    }

    .ledger-title {
      color: var(--ash);
      font-size: var(--fs-000);
      margin-block-end: var(--sp-2);
    }

    .ledger-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .ledger-list li {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr 1fr;
      gap: var(--sp-2);
      padding-block: var(--sp-1);
      border-block-end: var(--border-hairline);
      font-size: var(--fs-00);
      color: var(--ash);
    }

    .ledger-list .serial {
      color: var(--bone);
    }

    @media (max-width: 720px) {
      .proof {
        grid-template-columns: 1fr;
      }

      .doors {
        grid-template-columns: 1fr;
      }

      .door.vault {
        border-inline-start: none;
        border-block-start: var(--border-hairline);
      }

      .ledger-list li {
        grid-template-columns: 1fr 1fr;
        row-gap: var(--sp-1);
      }
    }
  </style>

  <script>
    const hero = document.querySelector<HTMLElement>('[data-intro]');
    if (hero) {
      try {
        const preferred = localStorage.getItem('ocd-locale');
        const current = hero.dataset.locale;
        const otherHome = hero.dataset.otherHome;
        if (preferred && current && preferred !== current && otherHome) {
          location.replace(otherHome);
        }
      } catch {
        /* storage unavailable — skip the redirect, not essential */
      }
    }

    const markIntroSeen = () => {
      try {
        sessionStorage.setItem('ocd-intro-seen', '1');
      } catch {
        /* ignore */
      }
    };

    const skipBtn = document.querySelector<HTMLButtonElement>('[data-skip-intro]');
    skipBtn?.addEventListener('click', markIntroSeen);

    if (hero) {
      let introSeen = false;
      try {
        introSeen = sessionStorage.getItem('ocd-intro-seen') === '1';
      } catch {
        /* ignore */
      }
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const preloader = hero.querySelector<HTMLElement>('[data-preloader]');

      const playHeroSequence = () => {
        const line = hero.querySelector<HTMLElement>('[data-intro-line]');
        const wordmark = hero.querySelector<HTMLElement>('.wordmark');
        const photo = hero.querySelector<HTMLElement>('.hero-photo img');

        import('gsap').then(({ default: gsap }) => {
          const rtl = getComputedStyle(hero).direction === 'rtl';
          const origin = rtl ? 'right center' : 'left center';

          const tl = gsap.timeline({
            defaults: { ease: 'expo.out' },
            onComplete: markIntroSeen,
          });

          if (line) {
            tl.from(line, { scaleX: 0, transformOrigin: origin, duration: 0.6 });
          }
          if (wordmark) {
            tl.from(
              wordmark,
              { opacity: 0, filter: 'blur(8px)', duration: 0.9 },
              '-=0.15',
            );
          }
          if (photo) {
            tl.fromTo(
              photo,
              { opacity: 0 },
              { opacity: 0.2, duration: 0.7 },
              '-=0.5',
            );
          }

          const skip = () => {
            tl.progress(1);
          };
          const events: (keyof WindowEventMap)[] = ['pointerdown', 'keydown', 'wheel', 'touchstart'];
          events.forEach((ev) => window.addEventListener(ev, skip, { once: true, passive: true }));
        });
      };

      if (introSeen || reduced) {
        markIntroSeen();
        preloader?.remove();
      } else if (preloader) {
        // Brief hold so the sprite/mark actually gets seen, then hand off to
        // the tuned hero sequence unchanged. Any input during the hold skips
        // straight past the preloader into that sequence (which is itself
        // still skippable by a second input, same as before this addition).
        let dismissed = false;
        const finishPreloader = () => {
          if (dismissed) return;
          dismissed = true;
          clearTimeout(holdTimer);
          preloader.classList.add('fade-out');
          setTimeout(() => preloader.remove(), 200);
          playHeroSequence();
        };
        const holdTimer = setTimeout(finishPreloader, 650);
        const events: (keyof WindowEventMap)[] = ['pointerdown', 'keydown', 'wheel', 'touchstart'];
        events.forEach((ev) => window.addEventListener(ev, finishPreloader, { once: true, passive: true }));
      } else {
        playHeroSequence();
      }
    }
  </script>
</BaseLayout>
