---
import type { CollectionEntry } from 'astro:content';
import { whatsappLink, claimMessage } from '../lib/contact';
import { pixelArtExists, pixelArtPath, spriteFrameCount } from '../lib/pixelArt';
import { isAssetMissing, getAsset } from '../lib/placeholders';
import PixelPlaceholder from './PixelPlaceholder.astro';

interface Props {
  entry: CollectionEntry<'flash'>;
}

const { entry } = Astro.props;
const f = entry.data;
const wa = whatsappLink(claimMessage(f.serial, f.title));

// The claim stamp — REDESIGN-PLAN.md §1/§6, the site's one orchestrated
// motion moment. Claimed rows get the animated sprite (plays once when the
// row scrolls into view, holds on its final frame — see the script below);
// available rows get the static "not stamped yet" counterpart. Both fall
// back to a loud placeholder until the real art exists (ASSETS-TO-DRAW.md).
const claimedFrames = f.status === 'claimed' ? await spriteFrameCount('stamp-claimed.png') : null;
const claimedAsset = getAsset('stamp-claimed');
const availableAsset = getAsset('stamp-available');
const hasAvailableStamp = f.status === 'available' && pixelArtExists('stamp-available.png');
---

<li class={`row status-${f.status}`} data-flash-row data-reveal data-grid-size={f.gridSize}>
  <div class="row-main">
    <span class="col-serial data">{f.serial}</span>
    <span class="col-title">{f.title}</span>
    <span class="col-placement data">{f.placement}</span>
    <span class="col-size data">{f.size}</span>
    <span class="col-gridsize data">{f.gridSize}</span>
    <span class="col-status">
      {
        f.status === 'available' ? (
          <Fragment>
            {hasAvailableStamp ? (
              <img class="stamp pixel-art" src={pixelArtPath('stamp-available.png')} alt="" width={availableAsset.width} height={availableAsset.height} loading="lazy" onerror="this.remove()" />
            ) : (
              isAssetMissing('stamp-available') && <PixelPlaceholder id="stamp-available" width={availableAsset.width} height={availableAsset.height} label="avail. stamp" />
            )}
            <button class="data claim-toggle" type="button" data-claim-toggle aria-expanded="false">
              Available →
            </button>
          </Fragment>
        ) : claimedFrames ? (
          <Fragment>
            <span
              class="stamp stamp-claimed-sprite pixel-art"
              data-claim-stamp
              data-src={pixelArtPath('stamp-claimed.png')}
              data-frames={claimedFrames}
              style={`--frames:${claimedFrames}; width:${claimedAsset.width}px; height:${claimedAsset.height}px;`}
              aria-hidden="true"
            />
            <span class="data claimed-label">Claimed · {f.claimedDate}</span>
          </Fragment>
        ) : (
          <Fragment>
            {isAssetMissing('stamp-claimed') && <PixelPlaceholder id="stamp-claimed" width={claimedAsset.width} height={claimedAsset.height} label="claim stamp" />}
            <span class="data claimed-label">Claimed · {f.claimedDate}</span>
          </Fragment>
        )
      }
    </span>
  </div>

  {
    f.status === 'available' && (
      <div class="claim-panel" data-claim-panel>
        <div class="claim-panel-inner">
          <p class="claim-copy">
            One-of-one. Drawn once, tattooed once. A deposit holds it — credited to the session, non-refundable.
          </p>
          <a class="wa data underline" href={wa} target="_blank" rel="noopener noreferrer">
            Confirm on WhatsApp →
          </a>
        </div>
      </div>
    )
  }
</li>

<style>
  .row {
    border-block-end: var(--border-hairline);
  }

  .row-main {
    display: grid;
    /* Last column widened from 9rem to fit the claim stamp (40px) + label
       on one line — it used to be text-only. */
    grid-template-columns: 8rem 1fr 7rem 4.5rem 4.5rem 12rem;
    gap: var(--sp-2);
    padding-block: var(--sp-2);
    align-items: center;
  }

  .col-serial {
    color: var(--paper);
  }

  .col-title {
    color: var(--paper);
    font-family: var(--font-body);
    font-size: var(--fs-1);
  }

  .col-placement,
  .col-size,
  .col-gridsize {
    color: var(--dust);
  }

  .col-status {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--sp-1);
    text-align: end;
  }

  .stamp {
    flex-shrink: 0;
  }

  /* Claim is the on-page action this row exists to drive — --claim, same
     color family as every other CTA on the site (Send, Start a
     commission). See REDESIGN-PLAN.md §2. */
  .claim-toggle {
    cursor: pointer;
    color: var(--claim);
    text-transform: uppercase;
    transition: color var(--dur-base) var(--ease-precise);
  }

  .claim-toggle:hover {
    color: var(--paper);
  }

  .status-claimed .col-title,
  .status-claimed .col-placement,
  .status-claimed .col-size,
  .status-claimed .col-gridsize {
    color: var(--dust);
  }

  .claimed-label {
    color: var(--dust);
  }

  /* Height is set explicitly in JS (measured from scrollHeight) rather than
     relying on a CSS-only max-height/grid-rows trick — neither reliably
     collapses to true 0 across browsers for content with padding. */
  .claim-panel {
    height: 0;
    overflow: hidden;
    transition: height var(--dur-base) var(--ease-precise);
  }

  .claim-panel-inner {
    overflow: hidden;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    padding: var(--sp-2) 0 var(--sp-3);
  }

  .claim-copy {
    max-width: 30rem;
    color: var(--dust);
    font-size: var(--fs-00);
  }

  /* WhatsApp keeps its own brand green, deliberately not --claim — this
     link always leaves the site for a different app, a different kind of
     moment than an on-page action. See REDESIGN-PLAN.md §2. */
  .wa {
    color: var(--whatsapp);
    text-decoration: none;
    text-transform: uppercase;
  }

  @media (max-width: 700px) {
    .row-main {
      grid-template-columns: 1fr 1fr;
      row-gap: 0.25rem;
    }

    .col-status {
      justify-content: flex-start;
      text-align: start;
    }
  }
</style>

<style is:global>
  /* Sprite-strip stepping for the claim stamp, following the same
     background-position math already established in pixel-art.css's
     .pixel-sprite (steps() looping animation) — this one plays once,
     driven by JS, not CSS animation, since it needs to start on
     scroll-into-view rather than on page load. */
  .stamp-claimed-sprite {
    display: inline-block;
    background-repeat: no-repeat;
    background-size: calc(var(--frames, 1) * 100%) 100%;
    background-position: 0 0;
  }
</style>

<script>
  // Accordion claim toggle — unchanged behavior from before the redesign.
  const rows = document.querySelectorAll<HTMLElement>('[data-flash-row]');
  rows.forEach((row) => {
    const toggle = row.querySelector<HTMLButtonElement>('[data-claim-toggle]');
    const panel = row.querySelector<HTMLElement>('[data-claim-panel]');
    if (!toggle || !panel) return;
    const close = (p: HTMLElement) => {
      p.style.height = '0px';
    };
    const open = (p: HTMLElement) => {
      p.style.height = `${p.scrollHeight}px`;
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      // Accordion behavior: opening one claim panel closes any other that's
      // open, so the register never shows more than one expanded at once.
      document.querySelectorAll<HTMLButtonElement>('[data-claim-toggle]').forEach((t) => {
        if (t !== toggle) {
          t.setAttribute('aria-expanded', 'false');
          const p = t.closest('[data-flash-row]')?.querySelector<HTMLElement>('[data-claim-panel]');
          if (p) close(p);
        }
      });
      toggle.setAttribute('aria-expanded', String(!isOpen));
      if (isOpen) close(panel);
      else open(panel);
    });
  });

  // The claim stamp — the site's one orchestrated motion moment. Plays once
  // per row, the first time it scrolls into view; holds on the final
  // frame; never loops, never replays. prefers-reduced-motion skips
  // straight to the final frame — the *result* (claimed) is never
  // motion-gated, only the flourish is. See REDESIGN-PLAN.md §6.
  const stamps = document.querySelectorAll<HTMLElement>('[data-claim-stamp]');
  if (stamps.length) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const src = el.dataset.src;
          const frames = Number(el.dataset.frames ?? '1');
          if (!src) return;

          const render = (frame: number) => {
            const pct = frames > 1 ? (frame / (frames - 1)) * 100 : 0;
            el.style.backgroundPosition = `${pct}% 0`;
          };

          const img = new Image();
          img.onerror = () => el.remove();
          img.onload = () => {
            el.style.backgroundImage = `url(${src})`;

            if (reduced) {
              render(frames - 1);
              return;
            }

            let frame = 0;
            let lastStep = 0;
            const STEP_MS = 1000 / 12; // ~12fps, per ASSETS-TO-DRAW.md

            const step = (ts: number) => {
              if (!lastStep) lastStep = ts;
              if (ts - lastStep >= STEP_MS) {
                frame++;
                lastStep = ts;
                render(frame);
                if (frame >= frames - 1) return; // holds here — no loop, no replay
              }
              requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          };
          img.src = src;
          observer.unobserve(el);
        });
      },
      { threshold: 0.4 },
    );
    stamps.forEach((el) => observer.observe(el));
  }
</script>
