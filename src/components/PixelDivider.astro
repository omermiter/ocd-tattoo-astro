---
// Repeatable pixel-art tile, an optional accent on top of the section
// hairlines that already separate the homepage. Purely decorative: renders
// nothing at all if divider.png hasn't been dropped in yet. Lazy — the
// background image is only requested once the divider nears the viewport.
import { pixelArtExists, pixelArtPath } from '../lib/pixelArt';

const hasDivider = pixelArtExists('divider.png');
const src = hasDivider ? pixelArtPath('divider.png') : '';
---

{hasDivider && <div class="pixel-divider" data-pixel-divider data-src={src} role="presentation" />}

<script>
  const dividers = document.querySelectorAll<HTMLElement>('[data-pixel-divider]');
  if (dividers.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const src = el.dataset.src;
          if (src) {
            const img = new Image();
            img.onload = () => {
              el.style.backgroundImage = `url(${src})`;
              el.dataset.loaded = 'true';
            };
            img.onerror = () => el.remove();
            img.src = src;
          }
          observer.unobserve(el);
        });
      },
      { rootMargin: '200px' },
    );
    dividers.forEach((el) => observer.observe(el));
  }
</script>
