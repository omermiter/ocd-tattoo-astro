---
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../Nav.astro';
import Footer from '../Footer.astro';
import HealedScrubber from '../HealedScrubber.astro';
import { getDict, type Locale } from '../../i18n';
import { pagePath } from '../../lib/paths';

interface Props {
  locale: Locale;
  entry: CollectionEntry<'work'>;
}

const { locale, entry } = Astro.props;
const t = getDict(locale);
const d = entry.data;
const title = locale === 'he' ? d.title_he : d.title_en;
const placement = locale === 'he' ? d.placement_he : d.placement_en;
const artistNote = locale === 'he' ? d.artistNote_he : d.artistNote_en;

const stages = [
  { key: 'reference', label: t.dossier.stageReference, img: d.images.reference },
  { key: 'stencil', label: t.dossier.stageStencil, img: d.images.stencil },
  { key: 'fresh', label: t.dossier.stageFresh, img: d.images.fresh },
  { key: 'healed', label: t.dossier.stageHealed, img: d.images.healed },
];
---

<BaseLayout locale={locale} title={`${d.serial} — ${title} — OCD Tattoo`} description={title}>
  <Nav locale={locale} active="work" />

  <main class="dossier">
    <div class="dossier-head">
      <a class="back mono" href={pagePath(locale, 'work')}>← {t.dossier.back}</a>
      <h1 class="mono serial">{d.serial}</h1>
    </div>

    <div class="spec-layout">
      <dl class="spec mono">
        <div><dt>{t.dossier.placement}</dt><dd>{placement}</dd></div>
        <div><dt>{t.dossier.sessions}</dt><dd>{d.sessions}</dd></div>
        <div><dt>{t.dossier.hours}</dt><dd>{d.hours}</dd></div>
        <div><dt>{t.dossier.date}</dt><dd class="ltr-num">{d.dateRange}</dd></div>
      </dl>

      <div class="stages" data-stages>
        {
          stages.map((s) => (
            <figure class="stage" data-stage={s.key}>
              <Picture
                src={s.img}
                alt={`${title} — ${s.label}`}
                formats={['avif', 'webp']}
                widths={[480, 900, 1400]}
                sizes="(min-width: 900px) 55vw, 100vw"
              />
              <figcaption class="mono">{s.label}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>

    <section class="comparison">
      <h2 class="mono comparison-title">{t.dossier.comparisonTitle}</h2>
      <HealedScrubber
        freshSrc={d.images.fresh}
        healedSrc={d.images.healed}
        freshLabel={t.home.freshLabel}
        healedLabel={t.home.healedLabel}
        dragHint={t.dossier.dragHint}
        alt={title}
      />
      <p class="note">{artistNote}</p>
    </section>
  </main>

  <Footer locale={locale} />

  <style>
    .dossier {
      max-width: var(--content-max);
      margin-inline: auto;
      padding: var(--sp-4) var(--sp-3);
    }

    .dossier-head {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      border-block-end: var(--border-hairline);
      padding-block-end: var(--sp-3);
      margin-block-end: var(--sp-4);
    }

    .back {
      color: var(--ash);
      text-decoration: none;
      font-size: var(--fs-00);
    }

    .back:hover {
      color: var(--pewter);
    }

    .serial {
      font-size: var(--fs-display-sm);
      color: var(--bone);
      font-weight: 400;
    }

    .spec-layout {
      display: grid;
      grid-template-columns: 14rem 1fr;
      gap: var(--sp-5);
      margin-block-end: var(--sp-6);
    }

    .spec {
      align-self: start;
      position: sticky;
      top: var(--sp-3);
      display: flex;
      flex-direction: column;
      gap: var(--sp-2);
      font-size: var(--fs-00);
    }

    .spec div {
      display: flex;
      justify-content: space-between;
      border-block-end: var(--border-hairline);
      padding-block-end: var(--sp-1);
      color: var(--ash);
    }

    .spec dd {
      margin: 0;
      color: var(--pewter);
    }

    .stages {
      display: flex;
      flex-direction: column;
      gap: var(--sp-5);
    }

    .stage {
      margin: 0;
    }

    .stage :global(img) {
      width: 100%;
      height: auto;
      border-radius: var(--radius-image);
    }

    .stage figcaption {
      margin-block-start: var(--sp-1);
      font-size: var(--fs-000);
      color: var(--ash);
    }

    /* Progressive enhancement: applied only once GSAP/ScrollTrigger confirm
       they can pin this container. Default (no-JS, reduced-motion, narrow
       viewport) stays the plain stacked layout above. */
    .stages.js-pinned {
      position: relative;
      block-size: 100vh;
    }

    .stages.js-pinned .stage {
      position: absolute;
      inset: 0;
      opacity: 0;
      display: flex;
      flex-direction: column;
    }

    .stages.js-pinned .stage :global(img) {
      flex: 1;
      height: 100%;
      object-fit: cover;
    }

    .stages.js-pinned .stage[data-stage='reference'] {
      opacity: 1;
    }

    .comparison {
      border-block-start: var(--border-hairline);
      padding-block-start: var(--sp-4);
    }

    .comparison-title {
      color: var(--ash);
      font-size: var(--fs-00);
      margin-block-end: var(--sp-3);
    }

    .note {
      max-width: 40rem;
      color: var(--pewter);
      margin-block-start: var(--sp-3);
    }

    @media (max-width: 800px) {
      .spec-layout {
        grid-template-columns: 1fr;
      }

      .spec {
        position: static;
        flex-direction: row;
        flex-wrap: wrap;
        gap: var(--sp-3);
      }

      .spec div {
        flex: 1 1 40%;
        flex-direction: column;
        gap: 0.25rem;
      }
    }
  </style>

  <script>
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wide = window.matchMedia('(min-width: 900px)').matches;
    const stagesEl = document.querySelector<HTMLElement>('[data-stages]');
    const figures = stagesEl ? Array.from(stagesEl.querySelectorAll<HTMLElement>('.stage')) : [];

    if (stagesEl && figures.length > 1 && !reduced && wide) {
      Promise.all([import('gsap'), import('gsap/ScrollTrigger'), import('lenis')]).then(
        ([{ default: gsap }, { ScrollTrigger }, { default: Lenis }]) => {
          gsap.registerPlugin(ScrollTrigger);

          const lenis = new Lenis({ duration: 1.1 });
          lenis.on('scroll', ScrollTrigger.update);
          const raf = (time: number) => {
            lenis.raf(time * 1000);
            requestAnimationFrame(raf);
          };
          requestAnimationFrame(raf);

          stagesEl.classList.add('js-pinned');

          const tl = gsap.timeline({
            scrollTrigger: {
              trigger: stagesEl,
              start: 'top top',
              end: () => `+=${(figures.length - 1) * window.innerHeight}`,
              scrub: 1,
              pin: true,
            },
          });

          figures.forEach((fig, i) => {
            if (i === 0) return;
            tl.to(figures[i - 1], { opacity: 0, duration: 1 }, i - 1).to(
              fig,
              { opacity: 1, duration: 1 },
              i - 1,
            );
          });
        },
      );
    }
  </script>
</BaseLayout>
