---
import type { CollectionEntry } from 'astro:content';
import { whatsappLink, claimMessage } from '../lib/contact';
import { pixelArtExists, pixelArtPath } from '../lib/pixelArt';

interface Props {
  entry: CollectionEntry<'flash'>;
}

const { entry } = Astro.props;
const f = entry.data;
const wa = whatsappLink(claimMessage(f.serial, f.title));

// Decorative reinforcement of the status already spelled out in the text
// next to it — empty alt so screen readers don't announce it twice.
const stampFile = f.status === 'available' ? 'stamp-available.png' : 'stamp-claimed.png';
const hasStamp = pixelArtExists(stampFile);
---

<li class={`row status-${f.status}`} data-flash-row data-reveal data-grid-size={f.gridSize}>
  <div class="row-main">
    <span class="col-serial data">{f.serial}</span>
    <span class="col-title">{f.title}</span>
    <span class="col-placement data">{f.placement}</span>
    <span class="col-size data">{f.size}</span>
    <span class="col-gridsize data">{f.gridSize}</span>
    <span class="col-status">
      {
        hasStamp && (
          <img
            class="pixel-stamp pixel-art"
            src={pixelArtPath(stampFile)}
            alt=""
            width="64"
            height="32"
            loading="lazy"
            onerror="this.remove()"
          />
        )
      }
      {
        f.status === 'available' ? (
          <button class="data claim-toggle" type="button" data-claim-toggle aria-expanded="false">
            Available →
          </button>
        ) : (
          <span class="data claimed-label">Claimed · {f.claimedDate}</span>
        )
      }
    </span>
  </div>

  {
    f.status === 'available' && (
      <div class="claim-panel" data-claim-panel>
        <div class="claim-panel-inner">
          <p class="claim-copy">
            One-of-one. Drawn once, tattooed once. A deposit holds it — credited to the session, non-refundable.
          </p>
          <a class="wa data underline" href={wa} target="_blank" rel="noopener noreferrer">
            Confirm on WhatsApp →
          </a>
        </div>
      </div>
    )
  }
</li>

<style>
  .row {
    border-block-end: var(--border-hairline);
  }

  .row-main {
    display: grid;
    grid-template-columns: 8rem 1fr 7rem 4.5rem 4.5rem 9rem;
    gap: var(--sp-2);
    padding-block: var(--sp-2);
    align-items: baseline;
  }

  .col-serial {
    color: var(--paper);
  }

  .col-title {
    color: var(--paper);
    font-family: var(--font-body);
    font-size: var(--fs-1);
  }

  .col-placement,
  .col-size,
  .col-gridsize {
    color: var(--dust);
  }

  .col-status {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--sp-1);
    text-align: end;
  }

  .claim-toggle {
    cursor: pointer;
    color: var(--violet-bright);
    text-transform: uppercase;
    transition: color var(--dur-base) var(--ease-precise);
  }

  .claim-toggle:hover {
    color: var(--paper);
  }

  .status-claimed .col-title,
  .status-claimed .col-placement,
  .status-claimed .col-size,
  .status-claimed .col-gridsize {
    color: var(--dust);
  }

  .claimed-label {
    color: var(--dust);
  }

  /* Height is set explicitly in JS (measured from scrollHeight) rather than
     relying on a CSS-only max-height/grid-rows trick — neither reliably
     collapses to true 0 across browsers for content with padding. */
  .claim-panel {
    height: 0;
    overflow: hidden;
    transition: height var(--dur-base) var(--ease-precise);
  }

  .claim-panel-inner {
    overflow: hidden;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    padding: var(--sp-2) 0 var(--sp-3);
  }

  .claim-copy {
    max-width: 30rem;
    color: var(--dust);
    font-size: var(--fs-00);
  }

  .wa {
    color: var(--violet-bright);
    text-decoration: none;
    text-transform: uppercase;
  }

  @media (max-width: 700px) {
    .row-main {
      grid-template-columns: 1fr 1fr;
      row-gap: 0.25rem;
    }

    .col-status {
      justify-content: flex-start;
      text-align: start;
    }
  }
</style>

<script>
  const rows = document.querySelectorAll<HTMLElement>('[data-flash-row]');
  rows.forEach((row) => {
    const toggle = row.querySelector<HTMLButtonElement>('[data-claim-toggle]');
    const panel = row.querySelector<HTMLElement>('[data-claim-panel]');
    if (!toggle || !panel) return;
    const close = (p: HTMLElement) => {
      p.style.height = '0px';
    };
    const open = (p: HTMLElement) => {
      p.style.height = `${p.scrollHeight}px`;
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      // Accordion behavior: opening one claim panel closes any other that's
      // open, so the register never shows more than one expanded at once.
      document.querySelectorAll<HTMLButtonElement>('[data-claim-toggle]').forEach((t) => {
        if (t !== toggle) {
          t.setAttribute('aria-expanded', 'false');
          const p = t.closest('[data-flash-row]')?.querySelector<HTMLElement>('[data-claim-panel]');
          if (p) close(p);
        }
      });
      toggle.setAttribute('aria-expanded', String(!isOpen));
      if (isOpen) close(panel);
      else open(panel);
    });
  });
</script>
