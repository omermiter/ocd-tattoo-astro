---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/pixel-art.css';
import Cursor from '../components/Cursor.astro';
import { pixelArtExists, pixelArtPath } from '../lib/pixelArt';

interface Props {
  locale: 'he' | 'en';
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const dir = locale === 'he' ? 'rtl' : 'ltr';

// The pixel-art signature favicon is additive, not a replacement: favicon.svg
// stays as the permanent fallback so the tab icon is never missing, and the
// hand-drawn one appears automatically the moment it's dropped in and the
// site rebuilds — no code change needed.
const hasPixelFavicon = pixelArtExists('favicon.png');
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    {hasPixelFavicon && <link rel="icon" href={pixelArtPath('favicon.png')} sizes="32x32" />}
    <meta name="description" content={description} />
    <title>{title}</title>
    <meta name="color-scheme" content="dark" />
  </head>
  <body>
    <Cursor />
    <slot />
  </body>
</html>
