---
interface Props {
  active?: 'pieces' | 'register' | 'contact';
}

const { active } = Astro.props;

const links = [
  { key: 'pieces', label: 'Pieces', href: '/pieces/' },
  { key: 'register', label: 'Register', href: '/register/' },
  { key: 'contact', label: 'Contact', href: '/contact/' },
] as const;
---

<nav class="nav">
  <a class="brand data" href="/">OCD·TATTOO</a>

  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-panel" aria-label="Menu">
    <span></span>
  </button>

  <div class="panel" id="nav-panel">
    <ul class="links data">
      {
        links.map((l) => (
          <li>
            <a class="underline" href={l.href} aria-current={active === l.key ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const panel = document.querySelector<HTMLElement>('#nav-panel');
  if (toggle && panel) {
    const close = () => {
      toggle.setAttribute('aria-expanded', 'false');
      panel.removeAttribute('data-open');
    };
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      if (open) panel.removeAttribute('data-open');
      else panel.setAttribute('data-open', 'true');
    });
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }
</script>

<style>
  .nav {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--sp-2) var(--sp-3);
    border-block-end: var(--border-hairline);
  }

  .brand {
    text-decoration: none;
    letter-spacing: 0.1em;
    color: var(--paper);
  }

  .menu-toggle {
    display: none;
    width: 20px;
    height: 14px;
    position: relative;
    cursor: pointer;
  }

  .menu-toggle span,
  .menu-toggle span::before,
  .menu-toggle span::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 1px;
    background: var(--paper);
  }

  .menu-toggle span {
    top: 6px;
  }

  .menu-toggle span::before {
    top: -6px;
  }

  .menu-toggle span::after {
    top: 6px;
  }

  .panel {
    display: contents;
  }

  .links {
    display: flex;
    gap: var(--sp-4);
    list-style: none;
    margin: 0;
    padding: 0;
    text-transform: uppercase;
  }

  .links a {
    text-decoration: none;
    color: var(--dust);
    transition: color var(--dur-base) var(--ease-precise);
  }

  .links a:hover {
    color: var(--paper);
  }

  .links a[aria-current='page'] {
    color: var(--violet-bright);
  }

  @media (max-width: 640px) {
    .menu-toggle {
      display: block;
    }

    .panel {
      display: block;
      position: absolute;
      inset-inline: 0;
      top: 100%;
      background: var(--ink);
      border-block-end: var(--border-hairline);
      opacity: 0;
      visibility: hidden;
      transition:
        opacity var(--dur-base) var(--ease-precise),
        visibility var(--dur-base) var(--ease-precise);
      z-index: 20;
    }

    .panel[data-open] {
      opacity: 1;
      visibility: visible;
    }

    .links {
      flex-direction: column;
      gap: 0;
    }

    .links a {
      display: block;
      padding: var(--sp-2) var(--sp-3);
      border-block-end: var(--border-hairline);
    }
  }
</style>
