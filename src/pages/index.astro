---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PrecisionGrid from '../components/PrecisionGrid.astro';
import PieceCard from '../components/PieceCard.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import Preloader from '../components/Preloader.astro';
import PixelDivider from '../components/PixelDivider.astro';
import { renderEmphasis } from '../lib/text';
import { hasPhoto } from '../lib/media';
import { whatsappLink, CONTACT_ENDPOINT } from '../lib/contact';
import { fetchGoogleReviews } from '../lib/googleReviews';
import site from '../data/site.json';

const pieces = (await getCollection('pieces')).sort((a, b) => (a.data.serial < b.data.serial ? -1 : 1));
const moreWork = (await getCollection('gallery')).filter((g) => hasPhoto(g.data.photo));
const { home, contact, googleReviews } = site;
const reviewsData = await fetchGoogleReviews(googleReviews.placeId);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: contact.studioName,
  image: 'https://ocdtattoo.com/uploads/img_1572.jpg',
  url: 'https://ocdtattoo.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: contact.address,
    addressCountry: 'IL',
  },
  sameAs: [contact.instagramUrl],
  ...(reviewsData && {
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: reviewsData.rating,
      reviewCount: reviewsData.reviewCount,
    },
  }),
};
---

<BaseLayout
  title="OCD Tattoo — Pixel Art Tattoos in Kfar Saba, Israel"
  description="Color pixel art tattoos built on years of black-and-gray realism training, at Topa Tattoo Studio in Kfar Saba. A growing collection of precision-built pieces, real Google reviews, and commissions reviewed personally."
  structuredData={structuredData}
>
  <Preloader />
  <Nav />

  <main>
    <PrecisionGrid>
      <section class="hero" style={`--heroBg: url(${home.heroBackground})`}>
        <div class="hero-content">
          <p class="eyebrow">{home.heroEyebrow}</p>
          <h1 set:html={renderEmphasis(home.heroTitle)} />
          <GoogleReviews data={reviewsData} mapsUrl={contact.mapsUrl} variant="compact" />
        </div>
      </section>
    </PrecisionGrid>

    <section class="beat" data-reveal>
      <p class="subhead">
        {home.beatText}
      </p>
      <a class="cta data underline" href="#pieces">See the work ↓</a>
    </section>

    <PixelDivider />

    <section class="section pieces" id="pieces">
      <header class="section-head" data-reveal>
        <p class="eyebrow">Pieces</p>
        <p class="intro">{home.piecesIntro}</p>
      </header>

      <div class="piece-list">
        {pieces.map((p) => <div data-reveal><PieceCard entry={p} /></div>)}
      </div>
    </section>

    <PixelDivider />

    {
      moreWork.length > 0 && (
        <section class="section more-work" id="gallery">
          <header class="section-head" data-reveal>
            <p class="eyebrow">More work</p>
            <p class="intro">{home.galleryIntro}</p>
          </header>

          <div class="work-grid">
            {moreWork.map((g) => (
              <figure class="work-item" data-reveal>
                <img src={g.data.photo} alt={g.data.title} loading="lazy" />
                <figcaption class="data">{g.data.title}</figcaption>
              </figure>
            ))}
          </div>

          <p class="work-note data">
            Anything above marked "flash" is a one-off design, ready to book as-is — ask about it below.
          </p>
        </section>
      )
    }

    <PixelDivider />

    <GoogleReviews data={reviewsData} mapsUrl={contact.mapsUrl}>
      <p class="intro">{home.reviewsIntro}</p>
    </GoogleReviews>

    <PixelDivider />

    <section class="section contact" id="contact">
      <header class="section-head" data-reveal>
        <p class="eyebrow">Contact</p>
        <h2>{home.closingTitle}</h2>
        <p class="intro">
          {home.contactIntro}
        </p>
      </header>

      <form class="form" data-contact-form novalidate data-reveal>
        <div class="field">
          <label class="data" for="name">Name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>

        <div class="field">
          <label class="data" for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>

        <div class="field">
          <label class="data" for="message">What are you looking for?</label>
          <textarea id="message" name="message" rows="6" placeholder="Placement, size, the idea — as much or as little as you have." required
          ></textarea>
        </div>

        <div class="actions">
          <button class="submit data" type="submit" data-submit>Send →</button>
          <p class="status data" data-status role="status" aria-live="polite"></p>
        </div>
      </form>
    </section>
  </main>

  <Footer />

  <style>
    .hero {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-block-size: 88vh;
      padding: var(--sp-3);
      /* Background image is CMS-editable — see home.heroBackground in
         src/data/site.json. Dark gradient on top exists purely so the title
         stays readable against the photo underneath. Full-bleed across the
         whole section; the text itself stays width-constrained via
         .hero-content below. */
      background-image: linear-gradient(180deg, rgba(8, 8, 10, 0.6), rgba(8, 8, 10, 0.82)), var(--heroBg);
      background-size: cover;
      background-position: center;
    }

    .hero-content {
      display: flex;
      flex-direction: column;
      gap: var(--sp-3);
      max-width: 60rem;
    }

    .hero h1 {
      font-size: var(--fs-display-lg);
    }

    .beat {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--sp-3);
      max-width: var(--content-max);
      margin-inline: auto;
      padding: var(--sp-5) var(--sp-3);
      border-block-start: var(--border-hairline);
    }

    .subhead {
      max-width: 34rem;
      color: var(--dust);
      font-size: var(--fs-2);
      line-height: 1.5;
    }

    /* Primary CTA — --claim by default, not just on hover: this is the
       site's one action color and should read as actionable at rest, not
       be discovered on hover. The shared .underline class already
       provides hover/focus feedback. See REDESIGN-PLAN.md §2. */
    .cta {
      flex-shrink: 0;
      color: var(--claim);
      text-transform: uppercase;
    }

    .section {
      max-width: var(--content-max);
      margin-inline: auto;
      padding: var(--sp-6) var(--sp-3);
      border-block-start: var(--border-hairline);
      scroll-margin-block-start: var(--sp-4);
    }

    .section-head {
      display: flex;
      flex-direction: column;
      gap: var(--sp-1);
      margin-block-end: var(--sp-5);
    }

    .section-head .eyebrow {
      text-transform: uppercase;
    }

    .section-head h2 {
      font-size: var(--fs-display-sm);
      margin-block: var(--sp-1);
    }

    .intro {
      max-width: 32rem;
      color: var(--dust);
      font-size: var(--fs-2);
    }

    .piece-list {
      display: flex;
      flex-direction: column;
      gap: var(--sp-6);
    }

    .work-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
      gap: var(--sp-3);
    }

    .work-item img {
      width: 100%;
      aspect-ratio: 1;
      object-fit: cover;
      display: block;
      background: var(--surface);
      border: var(--border-hairline);
    }

    .work-item figcaption {
      margin-block-start: var(--sp-1);
      color: var(--dust);
      font-size: var(--fs-00);
    }

    .work-note {
      margin-block-start: var(--sp-4);
      color: var(--dust);
    }

    /* ---- Contact form (folded in from the former /contact/ page) ---- */
    .contact .form {
      display: flex;
      flex-direction: column;
      gap: var(--sp-4);
      max-width: 34rem;
    }

    .field {
      display: flex;
      flex-direction: column;
      gap: var(--sp-1);
    }

    .field label {
      text-transform: uppercase;
      color: var(--dust);
    }

    .field input,
    .field textarea {
      border-block-end: var(--border-hairline);
      padding-block: var(--sp-1);
      font-size: var(--fs-2);
      color: var(--paper);
      background: transparent;
      resize: vertical;
    }

    .field input:focus,
    .field textarea:focus {
      border-color: var(--claim);
    }

    .actions {
      display: flex;
      align-items: center;
      gap: var(--sp-3);
      margin-block-start: var(--sp-2);
    }

    /* This is the site's highest-intent action — --claim at rest, same
       color family as every other CTA, not discovered on hover. See
       REDESIGN-PLAN.md §2. */
    .submit {
      cursor: pointer;
      color: var(--claim);
      text-transform: uppercase;
      border-block-end: 1px solid var(--claim);
      padding-block-end: 2px;
      transition: border-color var(--dur-base) var(--ease-precise);
    }

    .submit:hover {
      border-color: var(--paper);
    }

    .submit:disabled {
      cursor: default;
      color: var(--dust);
      border-color: var(--line);
    }

    .status {
      color: var(--dust);
    }

    .status[data-state='ok'] {
      color: var(--claim);
    }

    /* NOTE: the error state's WhatsApp link is injected via innerHTML at
       runtime (see the script below), so it never receives Astro's
       scoped-style attribute and a rule here would silently never match —
       confirmed by testing it live. Its color is set as an inline style
       directly in the generated markup instead, and stays --whatsapp, not
       --claim — see REDESIGN-PLAN.md §2. */

    @media (max-width: 800px) {
      .section {
        padding-block: var(--sp-5);
      }
    }
  </style>

  <script is:inline define:vars={{ wa: whatsappLink(), ENDPOINT: CONTACT_ENDPOINT }}>
  const form = document.querySelector('[data-contact-form]');
  const submitBtn = document.querySelector('[data-submit]');
  const status = document.querySelector('[data-status]');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!(form instanceof HTMLFormElement) || !submitBtn || !status) return;

    const data = new FormData(form);
    const payload = {
      name: String(data.get('name') ?? ''),
      email: String(data.get('email') ?? ''),
      message: String(data.get('message') ?? ''),
    };

    submitBtn.disabled = true;
    status.dataset.state = '';
    status.textContent = 'Sending…';

    try {
      const res = await fetch(ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error(String(res.status));
      status.dataset.state = 'ok';
      status.textContent = 'Sent. I read every message myself — expect a reply within a few days.';
      form.reset();
    } catch {
      status.dataset.state = 'error';
      status.innerHTML = `Something went wrong. Message me directly on <a class="underline" style="color:var(--whatsapp)" href="${wa}" target="_blank" rel="noopener noreferrer">WhatsApp</a> instead.`;
      submitBtn.disabled = false;
    }
  });
</script>
</BaseLayout>
