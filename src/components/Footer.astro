---
import { whatsappLink, INSTAGRAM_URL, INSTAGRAM_HANDLE } from '../lib/contact';
---

<footer class="footer">
  <span class="data">{INSTAGRAM_HANDLE} · Israel</span>
  <div class="links data">
    <a class="underline" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">Instagram</a>
    <a class="underline" href={whatsappLink()} target="_blank" rel="noopener noreferrer">WhatsApp</a>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-3);
    border-block-start: var(--border-hairline);
  }

  .links {
    display: flex;
    gap: var(--sp-3);
    text-transform: uppercase;
  }

  .links a {
    text-decoration: none;
    color: var(--dust);
    transition: color var(--dur-base) var(--ease-precise);
  }

  .links a:hover {
    color: var(--violet-bright);
  }
</style>
